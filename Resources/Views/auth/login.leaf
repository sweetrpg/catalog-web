#extend("base"):
	#export("body"):
		<section class="auth-page">
			<h1>Log in</h1>
			#if(auth0Configured):
				<p>Continue to sign in with your SweetRPG account.</p>
				<a class="btn btn-primary" href="#(meta.basePath)/auth/login">Continue to log in</a>
			#else:
				<p class="empty-state">Login isn't configured in this environment yet (AUTH0_DOMAIN / AUTH0_CLIENT_ID are unset). Set them via the deployment's Secret to enable this.</p>
			#endif
		</section>
	#endexport
#endextend
