#extend("base"):
	#export("body"):
		<a class="back-link" href="#(meta.basePath)/volumes/#(volumeID)">&larr; #(meta.l10n.version_history.back_prefix)#(volumeTitle)</a>

		<section class="page-header">
			<span class="section-label">#(meta.l10n.version_history.section)</span>
			<h2>#(volumeTitle)</h2>
		</section>

		#if(fetchFailed):
			<p class="form-error">#(meta.l10n.version_history.load_error)</p>
		#elseif(hasVersions):
			<table class="table">
				<thead>
					<tr>
						<th>#(meta.l10n.version_history.th_version)</th>
						<th>#(meta.l10n.version_history.th_state)</th>
						<th>#(meta.l10n.version_history.th_submitted_by)</th>
						<th>#(meta.l10n.version_history.th_submitted_at)</th>
						<th>#(meta.l10n.version_history.th_reviewed_by)</th>
						<th>#(meta.l10n.version_history.th_note)</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					#for(version in versions):
						<tr>
							<td><a href="#(meta.basePath)/volumes/#(volumeID)/versions/#(version.version)">#(version.version)</a></td>
							<td>
								#if(version.isLive):
									<span class="tag tag-accent tooltip-host" tabindex="0">#(meta.l10n.version_history.live)
										<span class="tooltip" role="tooltip">
											<span class="tooltip-title">#(meta.l10n.version_history.live_title)</span>
											<span class="tooltip-body">#(meta.l10n.version_history.live_body)</span>
										</span>
									</span>
								#else:
									<span class="tag tag-neutral">#(version.state)</span>
								#endif
							</td>
							<td>#(version.submittedBy)</td>
							<td>#(version.submittedAtLabel)</td>
							<td>
								#if(version.hasReviewedBy):
									#(version.reviewedBy)
								#endif
							</td>
							<td>
								#if(version.hasReviewNote):
									#(version.reviewNote)
								#endif
							</td>
							<td>
								#if(canRollback):
									#if(!version.isLive):
										<form method="post" action="#(meta.basePath)/volumes/#(volumeID)/versions/#(version.version)/restore">
											<button type="submit" class="btn btn-ghost">#(meta.l10n.version_history.restore)</button>
										</form>
									#endif
								#endif
							</td>
						</tr>
					#endfor
				</tbody>
			</table>
		#else:
			<p class="empty-state">#(meta.l10n.version_history.empty)</p>
		#endif
	#endexport
#endextend
