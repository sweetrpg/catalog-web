#extend("base"):
	#export("body"):
		<a class="back-link" href="#(meta.basePath)/studios">&larr; #(meta.l10n.entity.studios)</a>

		#if(justProposed):
			<p class="empty-state-inline">#(meta.l10n.common.just_proposed)</p>
		#endif

		#if(count(conflicts) > 0):
			<p class="form-error">#(meta.l10n.common.conflicts_prefix) #for(field in conflicts):#(field) #endfor</p>
		#endif

		#if(isDeleted):
			<p class="form-error">#(meta.l10n.studio.deleted_notice)</p>
		#endif

		<div>
			<h1>#(studio.name)</h1>
			<div class="tag-cloud">
				#for(tag in studio.tags):
					<span class="tag tag-accent">#(tag)</span>
				#endfor
			</div>

			#if(canEdit):
				<a class="btn btn-ghost" href="#(meta.basePath)/studios/#(studio.id)/edit">#(meta.l10n.common.edit)</a>
			#endif

			#if(canDelete):
				#if(isDeleted):
					<form method="post" action="#(meta.basePath)/studios/#(studio.id)/undelete">
						<button type="submit" class="btn btn-ghost">#(meta.l10n.common.restore)</button>
					</form>
				#else:
					<form method="post" action="#(meta.basePath)/studios/#(studio.id)/delete" onsubmit="return confirm('#(meta.l10n.studio.delete_confirm)')">
						<button type="submit" class="btn btn-ghost">#(meta.l10n.common.delete)</button>
					</form>
				#endif
			#endif

			#if(studio.hasWebsite):
				<p class="detail-notes"><strong>#(meta.l10n.common.website_label)</strong> <a href="#(studio.website)">#(studio.website)</a></p>
			#endif

			#if(studio.hasNotes):
				<p class="detail-notes"><strong>#(meta.l10n.common.notes_label)</strong> #(studio.notes)</p>
			#endif

			#if(review):
				<div class="detail-block">
					<span class="section-label">#(meta.l10n.common.pending_prefix)#(review.pendingCountLabel)#(meta.l10n.common.pending_suffix)</span>

					#if(review.hasMultiplePending):
						<form class="proposal-picker" method="get" action="#(meta.basePath)/studios/#(studio.id)">
							<label class="form-label" for="proposal">#(meta.l10n.common.viewing_proposal_from)</label>
							<select class="input" id="proposal" name="proposal" onchange="this.form.submit()">
								#for(option in review.options):
									<option value="#(option.version)" #if(option.isSelected): selected #endif>#(option.submittedBy) &mdash; #(option.submittedAtLabel)</option>
								#endfor
							</select>
						</form>
					#else:
						<p class="empty-state-inline">#(meta.l10n.common.proposed_by_prefix)#(review.submittedBy) #(meta.l10n.common.on) #(review.submittedAtLabel)#(meta.l10n.common.period)</p>
					#endif

					<form class="proposal-diff" method="post" action="#(meta.basePath)/studios/#(studio.id)/versions/#(review.selectedVersion)/accept">
						<input type="hidden" name="mode" value="subset">
						<table class="table">
							<thead>
								<tr>
									<th></th>
									<th>#(meta.l10n.common.field)</th>
									<th>#(meta.l10n.common.live_value)</th>
									<th>#(meta.l10n.common.proposed_value)</th>
								</tr>
							</thead>
							<tbody>
								#for(field in review.fields):
									<tr>
										<td><input type="checkbox" name="fields" value="#(field.key)"></td>
										<td>#(field.label)</td>
										<td>#(field.oldValue)</td>
										<td>#(field.newValue)</td>
									</tr>
								#endfor
							</tbody>
						</table>
						<div class="form-actions table-actions">
							<button type="submit" class="btn btn-ghost">#(meta.l10n.common.accept_selected)</button>
						</div>
					</form>

					<div class="table-actions">
						<form method="post" action="#(meta.basePath)/studios/#(studio.id)/versions/#(review.selectedVersion)/accept">
							<input type="hidden" name="mode" value="all">
							<button type="submit" class="btn btn-primary">#(meta.l10n.common.accept_all)</button>
						</form>
						<form method="post" action="#(meta.basePath)/studios/#(studio.id)/versions/#(review.selectedVersion)/reject">
							<input class="input" type="text" name="note" placeholder="#(meta.l10n.common.optional_note)">
							<button type="submit" class="btn btn-ghost">#(meta.l10n.common.reject)</button>
						</form>
					</div>
				</div>
			#endif

			<div class="detail-block">
				<span class="section-label">#(meta.l10n.studio.volumes)</span>
				#if(studio.hasVolumes):
					<div class="card-grid">
						#for(volume in studio.volumes):
							<a class="card" href="#(meta.basePath)/volumes/#(volume.id)">
								<div class="card-body">
									<div class="card-title">#(volume.title)</div>
								</div>
							</a>
						#endfor
					</div>
				#else:
					<p class="empty-state-inline">#(meta.l10n.studio.no_volumes)</p>
				#endif
			</div>
		</div>
	#endexport
#endextend
