#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">Browse</span>
			<h2>Studios</h2>
			<div class="page-header-toolbar">
				<form class="nav-search" action="#(meta.basePath)/studios" method="get">
					<input class="input" type="search" name="q" placeholder="Search studios" value="#(query)">
					<select class="input" name="order" onchange="this.form.submit()">
						<option value="asc" #if(orderIsAsc): selected #endif>Name (A-Z)</option>
						<option value="desc" #if(orderIsDesc): selected #endif>Name (Z-A)</option>
					</select>
				</form>
				#if(canEdit):
					<a class="btn btn-primary" href="#(meta.basePath)/studios/new">Add studio</a>
				#endif
			</div>
		</section>

		#if(noResults):
			<p class="empty-state">No studios match "#(query)".</p>
		#endif

		<div class="card-grid">
			#for(item in items):
				<a class="card" href="#(meta.basePath)/studios/#(item.id)">
					<div class="card-body">
						<div class="card-title">#(item.name)</div>
					</div>
				</a>
			#endfor
		</div>
	#endexport
#endextend
