#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#(meta.l10n.maintenance.section)</span>
			<h2>#(mode.label)</h2>
		</section>

		<div class="empty-state">
			<p>#(mode.description)</p>
			<p>#(meta.l10n.maintenance.started_prefix)#(mode.startsAt)</p>
			#if(mode.hasEndsAt):
				<p>#(meta.l10n.maintenance.expected_prefix)#(mode.endsAt)</p>
			#else:
				<p>#(meta.l10n.maintenance.no_end)</p>
			#endif
		</div>
	#endexport
#endextend
