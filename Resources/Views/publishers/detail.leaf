#extend("base"):
	#export("body"):
		<a class="back-link" href="#(meta.basePath)/publishers">&larr; #(meta.l10n.entity.publishers)</a>

		#if(justProposed):
			<p class="empty-state-inline">#(meta.l10n.common.just_proposed)</p>
		#endif

		#if(count(conflicts) > 0):
			<p class="form-error">#(meta.l10n.common.conflicts_prefix) #for(field in conflicts):#(field) #endfor</p>
		#endif

		#if(isDeleted):
			<p class="form-error">#(meta.l10n.publisher.deleted_notice)</p>
		#endif

		<div>
			<div class="detail-header-row">
				<h1>#(publisher.name)</h1>
				<span class="detail-header-actions">
					#if(canEdit):
						<a class="icon-btn" href="#(meta.basePath)/publishers/#(publisher.id)/edit" title="#(meta.l10n.common.tooltip_edit)">
							<img src="#(meta.sharedURL)/static/img/icons/edit.svg" alt="#(meta.l10n.common.tooltip_edit)">
						</a>
					#endif
					#if(canDelete):
						#if(isDeleted):
							<form method="post" action="#(meta.basePath)/publishers/#(publisher.id)/undelete">
								<button type="submit" class="icon-btn icon-btn-danger tooltip-host" aria-label="#(meta.l10n.common.tooltip_restore)">
									<span class="icon-mask" style="mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-restore-alt.svg'); -webkit-mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-restore-alt.svg');"></span>
									<span class="tooltip" role="tooltip">
										<span class="tooltip-title">#(meta.l10n.common.tooltip_restore)</span>
										<span class="tooltip-body">#(meta.l10n.common.tooltip_restore_body)</span>
									</span>
								</button>
							</form>
						#else:
							<form method="post" action="#(meta.basePath)/publishers/#(publisher.id)/delete" onsubmit="return confirm('#(meta.l10n.publisher.delete_confirm)')">
								<button type="submit" class="icon-btn icon-btn-danger tooltip-host" aria-label="#(meta.l10n.common.tooltip_delete)">
									<span class="icon-mask" style="mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg'); -webkit-mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg');"></span>
									<span class="tooltip" role="tooltip">
										<span class="tooltip-title">#(meta.l10n.common.tooltip_delete)</span>
										<span class="tooltip-body">#(meta.l10n.common.tooltip_delete_body)</span>
									</span>
								</button>
							</form>
						#endif
					#endif
				</span>
			</div>
			<div class="tag-cloud">
				#for(tag in publisher.tags):
					<span class="tag tag-accent">#(tag)</span>
				#endfor
			</div>

			#if(publisher.hasAddress):
				<p class="detail-notes"><strong>#(meta.l10n.common.address_label)</strong> #(publisher.address)</p>
			#endif

			#if(publisher.hasWebsite):
				<p class="detail-notes"><strong>#(meta.l10n.common.website_label)</strong> <a href="#(publisher.website)">#(publisher.website)</a></p>
			#endif

			#if(publisher.hasNotes):
				<p class="detail-notes"><strong>#(meta.l10n.common.notes_label)</strong> #(publisher.notes)</p>
			#endif

			#if(review):
				<div class="detail-block">
					<span class="section-label">#(meta.l10n.common.pending_prefix)#(review.pendingCount)#(meta.l10n.common.pending_suffix)</span>

					#if(review.hasMultiplePending):
						<form class="proposal-picker" method="get" action="#(meta.basePath)/publishers/#(publisher.id)">
							<label class="form-label" for="proposal">#(meta.l10n.common.viewing_proposal_from)</label>
							<select class="input" id="proposal" name="proposal" onchange="this.form.submit()">
								#for(option in review.options):
									<option value="#(option.version)" #if(option.isSelected): selected #endif>#(option.submittedBy) &mdash; #(option.submittedAtLabel)</option>
								#endfor
							</select>
						</form>
					#else:
						<p class="empty-state-inline">#(meta.l10n.common.proposed_by_prefix)#(review.submittedBy) #(meta.l10n.common.on) #(review.submittedAtLabel)#(meta.l10n.common.period)</p>
					#endif

					<form class="proposal-diff" method="post" action="#(meta.basePath)/publishers/#(publisher.id)/versions/#(review.selectedVersion)/accept">
						<input type="hidden" name="mode" value="subset">
						<table class="table">
							<thead>
								<tr>
									<th></th>
									<th>#(meta.l10n.common.field)</th>
									<th>#(meta.l10n.common.live_value)</th>
									<th>#(meta.l10n.common.proposed_value)</th>
								</tr>
							</thead>
							<tbody>
								#for(field in review.fields):
									<tr>
										<td><input type="checkbox" name="fields" value="#(field.key)"></td>
										<td>#(field.label)</td>
										<td>#(field.oldValue)</td>
										<td>#(field.newValue)</td>
									</tr>
								#endfor
							</tbody>
						</table>
						<div class="form-actions table-actions">
							<button type="submit" class="btn btn-ghost">#(meta.l10n.common.accept_selected)</button>
						</div>
					</form>

					<div class="table-actions">
						<form method="post" action="#(meta.basePath)/publishers/#(publisher.id)/versions/#(review.selectedVersion)/accept">
							<input type="hidden" name="mode" value="all">
							<button type="submit" class="btn btn-primary">#(meta.l10n.common.accept_all)</button>
						</form>
						<form method="post" action="#(meta.basePath)/publishers/#(publisher.id)/versions/#(review.selectedVersion)/reject">
							<input class="input" type="text" name="note" placeholder="#(meta.l10n.common.optional_note)">
							<button type="submit" class="btn btn-ghost">#(meta.l10n.common.reject)</button>
						</form>
					</div>
				</div>
			#endif

			<div class="detail-block">
				<span class="section-label">#(meta.l10n.publisher.volumes)</span>
				#if(publisher.hasVolumes):
					<div class="card-grid">
						#for(volume in publisher.volumes):
							<a class="card" href="#(meta.basePath)/volumes/#(volume.id)">
								<div class="card-body">
									<div class="card-title">#(volume.title)</div>
								</div>
							</a>
						#endfor
					</div>
				#else:
					<p class="empty-state-inline">#(meta.l10n.publisher.no_volumes)</p>
				#endif
			</div>
		</div>
	#endexport
#endextend
