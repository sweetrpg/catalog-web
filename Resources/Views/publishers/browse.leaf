#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#(meta.l10n.common.browse)</span>
			<h2>#(meta.l10n.entity.publishers)</h2>
			<div class="page-header-toolbar">
				<form class="nav-search" action="#(meta.basePath)/publishers" method="get">
					<input class="input" type="search" name="q" placeholder="#(meta.l10n.publishers.search_placeholder)" value="#(query)">
					<select class="input" name="order" onchange="this.form.submit()">
						<option value="asc" #if(orderIsAsc): selected #endif>#(meta.l10n.publishers.order_asc)</option>
						<option value="desc" #if(orderIsDesc): selected #endif>#(meta.l10n.publishers.order_desc)</option>
					</select>
				</form>
				#if(canEdit):
					<a class="btn btn-primary" href="#(meta.basePath)/publishers/new">#(meta.l10n.publishers.add)</a>
				#endif
			</div>
		</section>

		#if(noResults):
			<p class="empty-state">#(meta.l10n.publishers.no_results_prefix)#(query)#(meta.l10n.publishers.no_results_suffix)</p>
		#endif

		<div class="card-grid">
			#for(item in items):
				<a class="card" href="#(meta.basePath)/publishers/#(item.id)">
					<div class="card-body">
						<div class="card-title">#(item.name)</div>
						<span class="card-meta">#(item.volumeCountLabel)</span>
					</div>
				</a>
			#endfor
		</div>

		#extend("partials/pagination")
	#endexport
#endextend
