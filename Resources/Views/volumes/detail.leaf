#extend("base"):
	#export("body"):
		<link rel="stylesheet" href="#(meta.sharedURL)/static/css/catalog/detail.css">

		<a class="back-link" href="#(meta.basePath)/browse">&larr; #(meta.l10n.common.browse_stacks)</a>

		#if(justProposed):
			<p class="empty-state-inline">#(meta.l10n.common.just_proposed)</p>
		#endif

		#if(hasConflicts):
			<p class="form-error">#(meta.l10n.common.conflicts_prefix) #for(field in conflicts):#(field) #endfor</p>
		#endif

		#if(isDeleted):
			<p class="form-error">#(meta.l10n.volume.deleted_notice)</p>
		#endif

		<div class="detail-layout">
			<div class="card-cover detail-cover">
				<img class="card-cover-img" src="#(meta.assetsURL)/#(volume.coverAssetPath)" alt="#(volume.title)" loading="lazy" onerror="this.onerror=null;this.src='#(meta.sharedURL)/static/img/catalog/cover-placeholder-detail.png'">
			</div>

			<div>
				<div class="detail-header-row">
					<h1>#(volume.title)</h1>
					<span class="detail-header-actions">
						#if(canEdit):
							<a class="icon-btn" href="#(meta.basePath)/volumes/#(volume.id)/edit" title="#(meta.l10n.common.tooltip_edit)">
								<img src="#(meta.sharedURL)/static/img/icons/edit.svg" alt="#(meta.l10n.common.tooltip_edit)">
							</a>
						#endif
						<a class="icon-btn" href="#(meta.basePath)/volumes/#(volume.id)/versions" title="#(meta.l10n.version_history.section)">
							<img src="#(meta.sharedURL)/static/img/icons/history.svg" alt="#(meta.l10n.version_history.section)">
						</a>
						#if(canDelete):
							#if(isDeleted):
								<form method="post" action="#(meta.basePath)/volumes/#(volume.id)/undelete">
									<button type="submit" class="icon-btn icon-btn-danger" title="#(meta.l10n.common.tooltip_restore)">
										<span class="icon-mask" style="mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-restore-alt.svg'); -webkit-mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-restore-alt.svg');"></span>
									</button>
								</form>
							#else:
								<form method="post" action="#(meta.basePath)/volumes/#(volume.id)/delete" onsubmit="return confirm('#(meta.l10n.volume.delete_confirm)')">
									<button type="submit" class="icon-btn icon-btn-danger" title="#(meta.l10n.common.tooltip_delete)">
										<span class="icon-mask" style="mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg'); -webkit-mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg');"></span>
									</button>
								</form>
							#endif
						#endif
					</span>
				</div>

				#if(volume.hasDescription):
					<div class="detail-description">#unsafeHTML(volume.descriptionHTML)</div>
				#else:
					<p class="detail-description detail-description-empty">#(meta.l10n.volume.no_description)</p>
				#endif

				#if(volume.hasNotes):
					<p class="detail-notes"><strong>#(meta.l10n.common.notes_label)</strong> #(volume.notes)</p>
				#endif

				#if(volume.hasSystemNames):
					<div class="detail-block">
						<span class="section-label">#(meta.l10n.volume.section_system)</span>
						<div class="tag-cloud">
							#for(name in volume.systemNames):
								<span class="tag tag-neutral">#(name)</span>
							#endfor
						</div>
					</div>
				#endif

				#if(volume.hasLicenseNames):
					<div class="detail-block">
						<span class="section-label">#(meta.l10n.volume.section_license)</span>
						<div class="tag-cloud">
							#for(ref in volume.licenseRefs):
								<a class="tag tag-neutral" href="#(meta.basePath)/licenses/#(ref.id)">#(ref.name)#if(ref.isDeleted): #(meta.l10n.common.deleted_tag)#endif</a>
							#endfor
						</div>
					</div>
				#endif

				#if(review):
					<div class="detail-block">
						<span class="section-label">#(meta.l10n.common.pending_prefix)#(review.pendingCount)#(meta.l10n.common.pending_suffix)</span>

						#if(review.hasMultiplePending):
							<form class="proposal-picker" method="get" action="#(meta.basePath)/volumes/#(volume.id)">
								<label class="form-label" for="proposal">#(meta.l10n.common.viewing_proposal_from)</label>
								<select class="input" id="proposal" name="proposal" onchange="this.form.submit()">
									#for(option in review.options):
										<option value="#(option.version)" #if(option.isSelected): selected #endif>#(option.submittedBy) &mdash; #(option.submittedAtLabel)</option>
									#endfor
								</select>
							</form>
						#else:
							<p class="empty-state-inline">#(meta.l10n.common.proposed_by_prefix)#(review.submittedBy) #(meta.l10n.common.on) #(review.submittedAtLabel)#(meta.l10n.common.period)</p>
						#endif

						<form class="proposal-diff" method="post" action="#(meta.basePath)/volumes/#(volume.id)/versions/#(review.selectedVersion)/accept">
							<input type="hidden" name="mode" value="subset">
							<table class="table">
								<thead>
									<tr>
										<th></th>
										<th>#(meta.l10n.common.field)</th>
										<th>#(meta.l10n.common.live_value)</th>
										<th>#(meta.l10n.common.proposed_value)</th>
									</tr>
								</thead>
								<tbody>
									#for(field in review.fields):
										<tr>
											<td><input type="checkbox" name="fields" value="#(field.key)"></td>
											<td>#(field.label)</td>
											<td>#(field.oldValue)</td>
											<td>#(field.newValue)</td>
										</tr>
									#endfor
								</tbody>
							</table>
							<div class="form-actions table-actions">
								<button type="submit" class="btn btn-ghost">#(meta.l10n.common.accept_selected)</button>
							</div>
						</form>

						<div class="table-actions">
							<form method="post" action="#(meta.basePath)/volumes/#(volume.id)/versions/#(review.selectedVersion)/accept">
								<input type="hidden" name="mode" value="all">
								<button type="submit" class="btn btn-primary">#(meta.l10n.common.accept_all)</button>
							</form>
							<form method="post" action="#(meta.basePath)/volumes/#(volume.id)/versions/#(review.selectedVersion)/reject">
								<input class="input" type="text" name="note" placeholder="#(meta.l10n.common.optional_note)">
								<button type="submit" class="btn btn-ghost">#(meta.l10n.common.reject)</button>
							</form>
						</div>
					</div>
				#endif
			</div>
		</div>

		<div class="volume-tabs">
			<div class="tab-strip" role="tablist">
				#if(volume.hasSamples):
					<button type="button" id="volume-tab-samples" class="tab-btn active" role="tab" aria-selected="true" aria-controls="volume-panel-samples">#(meta.l10n.volume.tab_samples)</button>
				#endif
				<button type="button" id="volume-tab-credits" class="tab-btn#if(!volume.hasSamples): active#endif" role="tab" aria-selected="#if(volume.hasSamples):false#else:true#endif" aria-controls="volume-panel-credits">#(meta.l10n.volume.tab_credits)</button>
				<button type="button" id="volume-tab-publishing" class="tab-btn" role="tab" aria-selected="false" aria-controls="volume-panel-publishing">#(meta.l10n.volume.tab_publishing)</button>
				<button type="button" id="volume-tab-properties" class="tab-btn" role="tab" aria-selected="false" aria-controls="volume-panel-properties">#(meta.l10n.volume.tab_properties)</button>
				<button type="button" id="volume-tab-shelf" class="tab-btn" role="tab" aria-selected="false" aria-controls="volume-panel-shelf">#(meta.l10n.volume.tab_shelf)</button>
				<button type="button" id="volume-tab-reviews" class="tab-btn" role="tab" aria-selected="false" aria-controls="volume-panel-reviews">#(meta.l10n.volume.tab_reviews)</button>
			</div>

			#if(volume.hasSamples):
				<section class="tab-panel active" id="volume-panel-samples" role="tabpanel" aria-labelledby="volume-tab-samples">
					<div class="sample-thumbnails" id="sample-thumbnails">
						#for(path in volume.samplePaths):
							<img class="sample-thumbnail" src="#(meta.assetsURL)/#(path)" alt="Sample page" loading="lazy">
						#endfor
					</div>
				</section>
			#endif

			<section class="tab-panel#if(!volume.hasSamples): active#endif" id="volume-panel-credits" role="tabpanel" aria-labelledby="volume-tab-credits">
				#if(volume.hasCredits):
					<div class="detail-block">
						<span class="section-label">#(meta.l10n.volume.section_credits)</span>
						#for(credit in volume.credits):
							<p><strong>#(credit.person)</strong> &mdash; #(credit.role)</p>
						#endfor
					</div>
				#endif
			</section>

			<section class="tab-panel" id="volume-panel-publishing" role="tabpanel" aria-labelledby="volume-tab-publishing">
				#if(volume.hasTags):
					<div class="detail-block">
						<div class="tag-cloud">
							#for(tag in volume.tags):
								<span class="tag tag-accent">#(tag)</span>
							#endfor
						</div>
					</div>
				#endif
				#if(volume.hasPublisherNames):
					<div class="detail-block">
						<span class="section-label">#(meta.l10n.volume.section_publisher)</span>
						<div class="tag-cloud">
							#for(ref in volume.publisherRefs):
								<a class="tag tag-neutral" href="#(meta.basePath)/publishers/#(ref.id)">#(ref.name)#if(ref.isDeleted): #(meta.l10n.common.deleted_tag)#endif</a>
							#endfor
						</div>
					</div>
				#endif
				#if(volume.hasStudioNames):
					<div class="detail-block">
						<span class="section-label">#(meta.l10n.volume.section_studio)</span>
						<div class="tag-cloud">
							#for(ref in volume.studioRefs):
								<a class="tag tag-neutral" href="#(meta.basePath)/studios/#(ref.id)">#(ref.name)#if(ref.isDeleted): #(meta.l10n.common.deleted_tag)#endif</a>
							#endfor
						</div>
					</div>
				#endif
			</section>

			<section class="tab-panel" id="volume-panel-properties" role="tabpanel" aria-labelledby="volume-tab-properties">
				#if(volume.hasProperties):
					<div class="detail-block">
						<span class="section-label">#(meta.l10n.volume.section_properties)</span>
						<table class="table">
							<tbody>
								#for(property in volume.properties):
									<tr>
										<td>#(property.displayLabel)</td>
										<td>#(property.value)</td>
									</tr>
								#endfor
							</tbody>
						</table>
					</div>
				#endif
			</section>

			<section class="tab-panel" id="volume-panel-shelf" role="tabpanel" aria-labelledby="volume-tab-shelf">
				<!-- Shelf status, rating, and review will move here once shelf-api is wired up
				     (see ShelfAPIClient) - the design's prototype has this as browser-local
				     state today; this app doesn't persist anything client-side. -->
				<div class="detail-block">
					<span class="section-label">#(meta.l10n.volume.your_shelf)</span>
					<p class="empty-state-inline">#(meta.l10n.volume.shelf_empty)</p>
				</div>
			</section>

			<section class="tab-panel" id="volume-panel-reviews" role="tabpanel" aria-labelledby="volume-tab-reviews">
				<div class="detail-block">
					<span class="section-label">#(meta.l10n.volume.reviews_section)</span>
					#if(volume.hasReviews):
						#for(review in volume.reviews):
							<div class="review">
								<p><strong>#(review.author)</strong> <span class="review-stars">#(review.starsLabel)</span></p>
								<p>#(review.text)</p>
							</div>
						#endfor
					#else:
						<p class="empty-state-inline">#(meta.l10n.volume.reviews_empty)</p>
					#endif
				</div>
			</section>
		</div>

		<script>
		(function () {
		  // Tab switching (ARIA tabs pattern) - same rationale as the sample viewer below: this
		  // page has no client-side framework, so a small inline script toggles panels and
		  // handles arrow-key navigation between tabs.
		  var strip = document.querySelector('.volume-tabs');
		  if (!strip) return;
		  var tabs = Array.prototype.slice.call(strip.querySelectorAll('[role="tab"]'));

		  function activate(tab, focus) {
		    tabs.forEach(function (t) {
		      var on = t === tab;
		      t.classList.toggle('active', on);
		      t.setAttribute('aria-selected', on ? 'true' : 'false');
		      t.tabIndex = on ? 0 : -1;
		      var panel = document.getElementById(t.getAttribute('aria-controls'));
		      if (panel) panel.classList.toggle('active', on);
		    });
		    if (focus) tab.focus();
		  }

		  tabs.forEach(function (tab, i) {
		    tab.addEventListener('click', function () { activate(tab); });
		    tab.addEventListener('keydown', function (e) {
		      var delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
		      if (!delta) return;
		      e.preventDefault();
		      activate(tabs[(i + delta + tabs.length) % tabs.length], true);
		    });
		  });
		})();
		</script>

		#if(volume.hasSamples):
			<div class="sample-viewer" id="sample-viewer" hidden>
				<button type="button" class="sample-viewer-close" id="sample-viewer-close" aria-label="Close">&times;</button>
				<img class="sample-viewer-img" id="sample-viewer-img" src="" alt="Sample page, enlarged">
			</div>

			<script>
			(function () {
			  // Click-to-enlarge sample viewer (task 11.1) - a plain overlay, not a full lightbox
			  // library: this page has no client-side framework, and a handful of thumbnails don't
			  // need more than click-to-open/click-to-close.
			  var thumbnails = document.getElementById('sample-thumbnails');
			  var viewer = document.getElementById('sample-viewer');
			  var viewerImg = document.getElementById('sample-viewer-img');
			  var closeBtn = document.getElementById('sample-viewer-close');
			  if (!thumbnails || !viewer) return;

			  thumbnails.querySelectorAll('.sample-thumbnail').forEach(function (thumb) {
			    thumb.addEventListener('click', function () {
			      viewerImg.src = thumb.src;
			      viewer.hidden = false;
			    });
			  });

			  function close() {
			    viewer.hidden = true;
			    viewerImg.src = '';
			  }
			  closeBtn.addEventListener('click', close);
			  viewer.addEventListener('click', function (e) {
			    if (e.target === viewer) close();
			  });
			})();
			</script>
		#endif
	#endexport
#endextend
