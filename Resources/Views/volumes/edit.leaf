#extend("base"):
	#export("body"):
		<style>
		  /* Scoped to this page only - shared-web owns the global stylesheet, so page-specific
		     layout for the edit form's more complex controls (cover overlay, sample strip, tag
		     clouds) lives here instead of fighting global selectors or growing shared-web's CSS
		     for a single page's needs. */
		  #edit-form .input, #edit-form select, #edit-form textarea,
		  .tag-picker .input, .contributor-dialog .input, .contributor-dialog select {
		    border: none;
		    background: rgba(127, 127, 127, 0.08);
		    border-radius: 0.75rem;
		  }
		  #edit-form .input:focus, #edit-form select:focus, #edit-form textarea:focus,
		  .tag-picker .input:focus, .contributor-dialog .input:focus, .contributor-dialog select:focus {
		    outline: 2px solid var(--accent, #6366f1);
		    outline-offset: -2px;
		  }
		  /* Button shape is app-wide now (catalog/theme.css's .btn), no local override needed. */
		  #edit-form > div {
		    margin-top: 1.25rem;
		    padding-top: 1.25rem;
		    border-top: 1px solid var(--color-neutral-300, rgba(127, 127, 127, 0.15));
		  }
		  #edit-form > div:first-child {
		    margin-top: 0;
		    padding-top: 0;
		    border-top: none;
		  }
		  .contributor-dialog, .picker-results {
		    border-radius: 0.75rem;
		  }

		  /* Cover + samples share the grid's first column as one flow-stacked unit - grid-column
		     on .samples-field alone used to put it in a second grid row, which under CSS Grid's
		     sparse auto-placement also pushed the form column (title, description, ...) down to
		     that same row instead of aligning with the cover's top. */
		  .detail-cover-column {
		    display: flex;
		    flex-direction: column;
		    gap: 40px;
		  }
		  .card-cover.detail-cover {
		    aspect-ratio: unset;
		    flex-direction: column;
		    align-items: stretch;
		    justify-content: flex-start;
		  }
		  .cover-image-wrap {
		    position: relative;
		    display: block;
		    width: 100%;
		    aspect-ratio: 3 / 4;
		  }
		  .cover-overlay-controls {
		    position: absolute;
		    bottom: 0.5rem;
		    right: 0.5rem;
		    display: flex;
		    gap: 0.4rem;
		  }
		  .cover-overlay-controls .icon-btn {
		    background: rgba(0, 0, 0, 0.55);
		    border-radius: 50%;
		    width: 2rem;
		    height: 2rem;
		    display: flex;
		    align-items: center;
		    justify-content: center;
		    border: none;
		    cursor: pointer;
		  }
		  .cover-overlay-controls .icon-btn[hidden] { display: none; }
		  .cover-overlay-controls .icon-btn img {
		    width: 1.1rem;
		    height: 1.1rem;
		    filter: invert(1);
		  }
		  .cover-overlay-controls .cover-remove-trigger {
		    color: #fff;
		    font-size: 1.1rem;
		    line-height: 1;
		  }

		  .sample-thumbnails-row {
		    display: flex;
		    flex-wrap: wrap;
		    gap: 0.5rem;
		    margin-top: 0.75rem;
		  }
		  .sample-thumbnail-small {
		    width: 3.5rem;
		    height: 3.5rem;
		    object-fit: cover;
		    border-radius: 0.25rem;
		  }
		  .chip-list-thumbnails {
		    display: contents;
		  }
		  .chip-thumbnail-chip {
		    position: relative;
		    padding: 0;
		    border-radius: 0.25rem;
		    overflow: hidden;
		  }
		  .chip-thumbnail-chip .chip-thumbnail {
		    width: 3.5rem;
		    height: 3.5rem;
		    object-fit: cover;
		    display: block;
		  }
		  .chip-thumbnail-chip .chip-remove {
		    position: absolute;
		    top: 0;
		    right: 0;
		    background: rgba(0, 0, 0, 0.55);
		    color: #fff;
		    border: none;
		    width: 1.1rem;
		    height: 1.1rem;
		    line-height: 1;
		    border-radius: 0 0 0 0.25rem;
		    margin-left: 0;
		  }
		  #samples-field .sample-upload-label {
		    display: block;
		    width: fit-content;
		    margin: 0.75rem auto 0;
		    text-transform: none;
		    font-size: 14px;
		  }

		  /* Tag cloud (publisher/studio/format): chips plus a trailing "+" trigger, with an
		     inline reveal (not a popup) for the add/search affordance so keyboard focus and
		     Enter/Escape stay predictable. */
		  .tag-cloud-field .chip-list {
		    display: flex;
		    flex-wrap: wrap;
		    align-items: center;
		    gap: 0.4rem;
		  }
		  .tag-cloud-field .chip {
		    cursor: pointer;
		  }
		  .chip-add-trigger {
		    border: none;
		    background: rgba(127, 127, 127, 0.15);
		    border-radius: 999px;
		    width: 1.6rem;
		    height: 1.6rem;
		    line-height: 1;
		    cursor: pointer;
		    font-size: 1rem;
		  }
		  .tag-picker {
		    display: flex;
		    align-items: center;
		    gap: 0.4rem;
		    margin-top: 0.4rem;
		    position: relative;
		  }
		  /* `display: flex` above beats the UA [hidden]{display:none} default on a specificity
		     tie, so the picker row (and the contributor dialog below) rendered even when their
		     `hidden` attribute was set - this override is required, not decorative. */
		  .tag-picker[hidden] {
		    display: none;
		  }
		  .tag-picker .picker-filter {
		    flex: 1;
		  }
		  .tag-picker-cancel {
		    border: none;
		    background: transparent;
		    border-radius: 50%;
		    width: 1.6rem;
		    height: 1.6rem;
		    line-height: 1;
		    cursor: pointer;
		  }
		  .tag-picker-cancel:hover {
		    background: rgba(127, 127, 127, 0.15);
		  }
		  #edit-form .chip {
		    border: none;
		  }
		  .chip-remove {
		    display: inline-flex;
		    align-items: center;
		    justify-content: center;
		    border: none;
		    background: transparent;
		    border-radius: 50%;
		    width: 1.1rem;
		    height: 1.1rem;
		    min-width: 1.1rem;
		    padding: 0;
		    margin-left: 0.35rem;
		    line-height: 1;
		    font-size: 0.9rem;
		    cursor: pointer;
		    color: color-mix(in srgb, var(--color-text) 55%, transparent);
		  }
		  .chip-remove:hover {
		    background: color-mix(in srgb, #7a1212 18%, transparent);
		    color: #7a1212;
		  }
		  [data-theme="dark"] .chip-remove:hover {
		    background: color-mix(in srgb, #f5a3a3 22%, transparent);
		    color: #f5a3a3;
		  }
		  /* Search-result overlays (publisher/studio/format pickers and the contributor dialog's
		     person search): positioned below the input via the `position: relative` anchor each
		     already sets (.tag-picker above, .contributor-dialog-label below) instead of taking
		     up their own flex/flow slot, which used to push surrounding content aside. */
		  .tag-picker .picker-results,
		  .contributor-dialog-label .picker-results {
		    position: absolute;
		    top: 100%;
		    left: 0;
		    right: 0;
		    z-index: 10;
		    margin: 0.25rem 0 0;
		    max-height: 220px;
		    overflow-y: auto;
		    list-style: none;
		    padding: 0.25rem;
		    background: var(--color-surface);
		    border: none;
		    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
		  }
		  .picker-results li {
		    padding: 0.4rem 0.6rem;
		    border-radius: var(--radius-md);
		    cursor: pointer;
		  }
		  .picker-results li:hover {
		    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
		  }
		  .picker-results li.picker-add-new {
		    font-style: italic;
		    opacity: 0.85;
		  }
		  .contributor-dialog-label {
		    position: relative;
		  }
		  .contributor-dialog {
		    display: flex;
		    flex-direction: column;
		    gap: 0.6rem;
		    margin-top: 0.6rem;
		    padding: 0.75rem;
		    border-radius: 0.5rem;
		    background: rgba(127, 127, 127, 0.06);
		  }
		  .contributor-dialog[hidden] {
		    display: none;
		  }
		  .contributor-dialog-header {
		    display: flex;
		    align-items: center;
		    justify-content: space-between;
		  }
		  .contributor-dialog-title {
		    font-weight: var(--font-heading-weight);
		  }
		  .contributor-dialog-header .icon-btn {
		    width: 1.75rem;
		    height: 1.75rem;
		  }
		  .contributor-dialog-row {
		    display: flex;
		    align-items: flex-end;
		    gap: 0.6rem;
		  }
		  .contributor-dialog-row .contributor-dialog-label {
		    flex: 1;
		    min-width: 0;
		  }
		  .contributor-dialog-row .icon-btn {
		    flex-shrink: 0;
		    width: 2rem;
		    height: 2rem;
		  }
		  .contributor-add-type {
		    display: flex;
		    align-items: center;
		    gap: 0.4rem;
		    margin-top: 0.3rem;
		  }
		  .contributor-add-type input {
		    flex: 1;
		    min-width: 0;
		  }
		  .contributor-add-type .icon-btn {
		    flex-shrink: 0;
		    width: 2rem;
		    height: 2rem;
		  }
		  .property-add-row,
		  .property-add-name {
		    display: flex;
		    align-items: center;
		    gap: 0.4rem;
		    margin-top: 0.5rem;
		    flex-wrap: wrap;
		  }
		  .property-add-row select,
		  .property-add-row input,
		  .property-add-name input {
		    flex: 1;
		    min-width: 0;
		  }
		  .property-add-row .icon-btn,
		  .property-add-name .icon-btn {
		    flex-shrink: 0;
		    width: 2rem;
		    height: 2rem;
		  }
		  .field-actions .icon-btn {
		    width: 1.75rem;
		    height: 1.75rem;
		    padding: 0.35rem;
		  }
		  .field-edit-trigger {
		    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
		  }
		  .field-edit-trigger:hover {
		    background: color-mix(in srgb, var(--color-accent) 26%, transparent);
		  }
		  .field-actions .icon-btn img {
		    width: 1rem;
		    height: 1rem;
		  }
		  .field-cancel-trigger:hover {
		    background: color-mix(in srgb, #7a1212 22%, transparent);
		  }
		  .cover-overlay-controls .cover-remove-trigger:hover {
		    background: color-mix(in srgb, #7a1212 65%, rgba(0, 0, 0, 0.55));
		  }
		  .discard-changes-trigger {
		    border-color: transparent;
		  }
		  .discard-changes-trigger:hover {
		    background: color-mix(in srgb, #7a1212 15%, transparent);
		    color: #7a1212;
		    border-color: transparent;
		  }
		</style>

		<a class="back-link" href="#(meta.basePath)/volumes/#(volume.id)">&larr; #(volume.title)</a>

		#if(hasSubmitError):
			<p class="form-error">#(submitError)</p>
		#endif

		<div class="detail-layout">
			<div class="detail-cover-column">
			<div class="card-cover detail-cover">
				<div class="cover-image-wrap">
					<img class="card-cover-img" id="cover-preview-img" src="#(meta.assetsURL)/#(volume.coverAssetPath)" alt="#(volume.title)" loading="lazy" onerror="this.onerror=null;this.src='#(meta.sharedURL)/static/img/catalog/cover-placeholder-detail.png'">
					#if(canUploadCover):
						<div class="cover-overlay-controls" data-assets-url="#(meta.assetsURL)" data-staged-cover-path="asset/cover-staged/#(volume.userSub)" data-session-cover-url="#(meta.basePath)/volumes/#(volume.id)/edit/session/cover" data-live-cover-path="#(volume.liveCoverPath)">
							<label class="icon-btn cover-edit-trigger" for="cover-upload-input" title="Change cover">
								<img src="#(meta.sharedURL)/static/img/icons/edit.svg" alt="Change cover">
							</label>
							#if(volume.hasStagedCover):
								<button type="button" class="icon-btn cover-remove-trigger" id="cover-remove-trigger" title="Remove staged cover">&times;</button>
							#else:
								<button type="button" class="icon-btn cover-remove-trigger" id="cover-remove-trigger" title="Remove staged cover" hidden>&times;</button>
							#endif
							<input type="file" id="cover-upload-input" accept="image/png,image/jpeg,image/webp" hidden>
						</div>
					#endif
				</div>
				#if(canUploadCover):
					<p class="form-error cover-upload-error" hidden></p>
				#endif
			</div>

			<div class="samples-field" id="samples-field" data-assets-url="#(meta.assetsURL)" data-user-sub="#(volume.userSub)" data-session-url="#(meta.basePath)/volumes/#(volume.id)/edit/session/samples">
				<div class="sample-thumbnails-row" id="sample-thumbnails-row">
					#if(volume.hasLivingSamples):
						#for(path in volume.livingSamplePaths):
							<img class="sample-thumbnail-small" src="#(meta.assetsURL)/#(path)" alt="Sample page" loading="lazy">
						#endfor
					#endif
					<div class="chip-list chip-list-thumbnails" id="staged-sample-list" data-chip-list>
						#for(sample in volume.stagedSamples):
							<span class="chip chip-thumbnail-chip" data-id="#(sample.id)"><img class="chip-thumbnail" src="#(meta.assetsURL)/#(sample.path)" alt="Staged sample"><button type="button" class="chip-remove" title="Remove this sample">&times;</button></span>
						#endfor
					</div>
				</div>
				<label class="btn btn-ghost sample-upload-label" for="sample-upload-input" id="sample-upload-trigger">Add sample</label>
				<input type="file" id="sample-upload-input" accept="image/png,image/jpeg,image/webp" hidden>
				<p class="form-error" id="sample-upload-error" hidden></p>
			</div>
			</div>

			<div>
				<form id="edit-form" action="#(meta.basePath)/volumes/#(volume.id)/edit" method="post" data-session-fields-url="#(meta.basePath)/volumes/#(volume.id)/edit/session/fields">
					<div class="field-row" data-field="title" data-field-type="line">
						<h1 class="field-display">#(volume.title)</h1>
						<input class="input field-input" type="text" name="title" value="#(volume.title)" required hidden>
						<span class="field-actions">
							<button type="button" class="icon-btn field-edit-trigger" title="Edit title">
								<img src="#(meta.sharedURL)/static/img/icons/edit.svg" alt="Edit title">
							</button>
							<button type="button" class="icon-btn field-accept-trigger" title="Accept" hidden>
								<img src="#(meta.sharedURL)/static/img/icons/accept.svg" alt="Accept">
							</button>
							<button type="button" class="icon-btn field-cancel-trigger" title="Cancel" hidden>
								<img src="#(meta.sharedURL)/static/img/icons/cancel.svg" alt="Cancel">
							</button>
						</span>
					</div>

					<div class="field-row field-row-block" data-field="description" data-field-type="block">
						#if(volume.hasDescription):
							<p class="detail-description field-display">#(volume.description)</p>
						#else:
							<p class="detail-description detail-description-empty field-display">No description on file yet for this volume.</p>
						#endif
						<textarea class="input field-input" name="description" rows="4" hidden>#(volume.description)</textarea>
						<span class="field-actions">
							<button type="button" class="icon-btn field-edit-trigger" title="Edit description">
								<img src="#(meta.sharedURL)/static/img/icons/edit.svg" alt="Edit description">
							</button>
							<button type="button" class="icon-btn field-accept-trigger" title="Accept" hidden>
								<img src="#(meta.sharedURL)/static/img/icons/accept.svg" alt="Accept">
							</button>
							<button type="button" class="icon-btn field-cancel-trigger" title="Cancel" hidden>
								<img src="#(meta.sharedURL)/static/img/icons/cancel.svg" alt="Cancel">
							</button>
						</span>
					</div>

					<div class="picker-field tag-cloud-field" data-picker="system" data-session-url="#(meta.basePath)/volumes/#(volume.id)/edit/session/associations">
						<h3>Game Systems</h3>
						<div class="chip-list" data-chip-list>
							#for(system in volume.selectedSystems):
								<span class="chip" data-id="#(system.id)" data-name="#(system.name)"><span class="chip-label">#(system.name)</span><button type="button" class="chip-remove" title="Remove #(system.name)">&times;</button></span>
							#endfor
							<button type="button" class="chip-add-trigger" title="Add a game system">+</button>
						</div>
						<div class="tag-picker" hidden>
							<input type="text" class="input picker-filter" placeholder="Search game systems..." autocomplete="off">
							<ul class="picker-results" hidden></ul>
							<button type="button" class="tag-picker-cancel" title="Cancel">&times;</button>
						</div>
						<script type="application/json" class="picker-options">#unsafeHTML(volume.systemOptionsJSON)</script>
					</div>

					<div class="picker-field tag-cloud-field" data-picker="publisher" data-session-url="#(meta.basePath)/volumes/#(volume.id)/edit/session/associations">
						<h3>Publishers</h3>
						<div class="chip-list" data-chip-list>
							#for(pub in volume.selectedPublishers):
								<span class="chip" data-id="#(pub.id)" data-name="#(pub.name)"><span class="chip-label">#(pub.name)</span><button type="button" class="chip-remove" title="Remove #(pub.name)">&times;</button></span>
							#endfor
							<button type="button" class="chip-add-trigger" title="Add a publisher">+</button>
						</div>
						<div class="tag-picker" hidden>
							<input type="text" class="input picker-filter" placeholder="Search publishers..." autocomplete="off">
							<ul class="picker-results" hidden></ul>
							<button type="button" class="tag-picker-cancel" title="Cancel">&times;</button>
						</div>
						<script type="application/json" class="picker-options">#unsafeHTML(volume.publisherOptionsJSON)</script>
					</div>

					<div class="picker-field tag-cloud-field" data-picker="studio" data-session-url="#(meta.basePath)/volumes/#(volume.id)/edit/session/associations">
						<h3>Studios</h3>
						<div class="chip-list" data-chip-list>
							#for(studio in volume.selectedStudios):
								<span class="chip" data-id="#(studio.id)" data-name="#(studio.name)"><span class="chip-label">#(studio.name)</span><button type="button" class="chip-remove" title="Remove #(studio.name)">&times;</button></span>
							#endfor
							<button type="button" class="chip-add-trigger" title="Add a studio">+</button>
						</div>
						<div class="tag-picker" hidden>
							<input type="text" class="input picker-filter" placeholder="Search studios..." autocomplete="off">
							<ul class="picker-results" hidden></ul>
							<button type="button" class="tag-picker-cancel" title="Cancel">&times;</button>
						</div>
						<script type="application/json" class="picker-options">#unsafeHTML(volume.studioOptionsJSON)</script>
					</div>

					<div class="credits-field tag-cloud-field" id="credits-field" data-session-url="#(meta.basePath)/volumes/#(volume.id)/edit/session/credits" data-vocabulary-url="#(meta.basePath)/volumes/#(volume.id)/edit/vocabulary/contribution-type">
						<h3>Contributors</h3>
						<div class="chip-list" data-chip-list>
							#for(credit in volume.selectedCredits):
								<span class="chip" data-person-id="#(credit.personId)" data-person-name="#(credit.personName)" data-contribution-type="#(credit.contributionType)"><span class="chip-label">#(credit.personName) &mdash; #(credit.contributionType)</span><button type="button" class="chip-remove" title="Remove #(credit.personName)">&times;</button></span>
							#endfor
							<button type="button" class="chip-add-trigger" id="add-contributor-trigger" title="Add a contributor">+</button>
						</div>
						<script type="application/json" id="contributor-person-options">#unsafeHTML(volume.personOptionsJSON)</script>
						<script type="application/json" id="contributor-type-options">#unsafeHTML(volume.contributionTypeOptionsJSON)</script>

						<div class="contributor-dialog" id="contributor-dialog" hidden>
							<div class="contributor-dialog-header">
								<span class="contributor-dialog-title">Add contributor</span>
								<button type="button" class="icon-btn" id="contributor-cancel-trigger" title="Close">
									<img src="#(meta.sharedURL)/static/img/icons/cancel.svg" alt="Close">
								</button>
							</div>
							<div class="contributor-dialog-row">
								<label class="contributor-dialog-label">
									Person
									<input type="text" class="input" id="contributor-person-filter" placeholder="Find a person..." autocomplete="off">
									<ul class="picker-results" id="contributor-person-results" hidden></ul>
								</label>
								<label class="contributor-dialog-label">
									Contribution type
									<select class="input" id="contributor-type-select">
										<option value="">Select a type&hellip;</option>
									</select>
								</label>
								<button type="button" class="icon-btn" id="contributor-confirm-trigger" title="Add" disabled>
									<img class="icon-invert" src="#(meta.sharedURL)/static/svgs/fontawesome/solid/plus.svg" alt="Add">
								</button>
							</div>
							<p class="contributor-selected-person" id="contributor-selected-person" hidden></p>

							#if(volume.canAddContributionType):
								<div class="contributor-add-type">
									<input type="text" class="input" id="contributor-new-type" placeholder="Add a new contribution type...">
									<button type="button" class="icon-btn" id="contributor-add-type-trigger" title="Add a new contribution type">
										<img src="#(meta.sharedURL)/static/img/icons/accept.svg" alt="Add type">
									</button>
								</div>
								<p class="form-error" id="contributor-add-type-error" hidden></p>
							#endif
						</div>
					</div>

					<div class="properties-field" id="properties-field" data-session-url="#(meta.basePath)/volumes/#(volume.id)/edit/session/properties" data-vocabulary-url="#(meta.basePath)/volumes/#(volume.id)/edit/vocabulary/property-name">
						<h3>Properties</h3>
						<div class="chip-list" data-chip-list>
							#for(property in volume.selectedProperties):
								<span class="chip" data-name="#(property.name)" data-value="#(property.value)">#(property.displayLabel): #(property.value)<button type="button" class="chip-remove" title="Remove #(property.displayLabel)">&times;</button></span>
							#endfor
						</div>
						<script type="application/json" id="property-name-options">#unsafeHTML(volume.propertyNameOptionsJSON)</script>

						<div class="property-add-row">
							<select class="input" id="property-name-select">
								<option value="">Select a property&hellip;</option>
							</select>
							<input type="text" class="input" id="property-value-input" placeholder="Value">
							<button type="button" class="icon-btn" id="property-add-trigger" title="Add" disabled>
								<img src="#(meta.sharedURL)/static/img/icons/accept.svg" alt="Add">
							</button>
						</div>

						#if(volume.canAddPropertyName):
							<div class="property-add-name">
								<input type="text" class="input" id="property-new-name" placeholder="Add a new property name...">
								<button type="button" class="icon-btn" id="property-add-name-trigger" title="Add a new property name">
									<img src="#(meta.sharedURL)/static/img/icons/accept.svg" alt="Add name">
								</button>
								<p class="form-error" id="property-add-name-error" hidden></p>
							</div>
						#endif
					</div>

					<div class="field-row field-row-block" data-field="notes" data-field-type="block">
						#if(volume.hasNotes):
							<p class="detail-notes field-display"><strong>Notes:</strong> #(volume.notes)</p>
						#else:
							<p class="detail-notes detail-description-empty field-display">No notes on file yet for this volume.</p>
						#endif
						<textarea class="input field-input" name="notes" rows="3" hidden>#(volume.notes)</textarea>
						<span class="field-actions">
							<button type="button" class="icon-btn field-edit-trigger" title="Edit notes">
								<img src="#(meta.sharedURL)/static/img/icons/edit.svg" alt="Edit notes">
							</button>
							<button type="button" class="icon-btn field-accept-trigger" title="Accept" hidden>
								<img src="#(meta.sharedURL)/static/img/icons/accept.svg" alt="Accept">
							</button>
							<button type="button" class="icon-btn field-cancel-trigger" title="Cancel" hidden>
								<img src="#(meta.sharedURL)/static/img/icons/cancel.svg" alt="Cancel">
							</button>
						</span>
					</div>

					<div class="form-actions">
						<button type="submit" class="btn btn-primary">Save changes</button>
						<button type="submit" form="discard-form" class="btn btn-ghost discard-changes-trigger">Discard changes</button>
					</div>
				</form>

				<form id="discard-form" action="#(meta.basePath)/volumes/#(volume.id)/edit/session/discard" method="post" data-staged-cover-path="asset/cover-staged/#(volume.userSub)" data-assets-url="#(meta.assetsURL)">
					<input type="hidden" name="redirect" value="#(meta.basePath)/volumes/#(volume.id)">
				</form>
			</div>
		</div>

		<script>
		(function () {
		  // Enter in any text input on this page must never implicitly submit #edit-form - the
		  // page has several free-text inputs with their own Enter/click-driven behavior
		  // (publisher/studio picker, contributor type, property name/value, format) that have
		  // nothing to do with saving the whole form. Without this, Enter in any of them fires
		  // the browser's default "submit nearest form" behavior, silently saving and redirecting
		  // to the detail page. Capture phase so it runs before (and independent of) the
		  // per-field line/block handlers below, which call preventDefault themselves anyway.
		  document.getElementById('edit-form').addEventListener('keydown', function (e) {
		    if (e.key === 'Enter' && e.target.tagName === 'INPUT') e.preventDefault();
		  }, true);
		})();
		</script>

		<script>
		(function () {
		  // Inline per-field editing: "line" fields (title) commit on Enter or blur; "block"
		  // fields (description, notes) commit via explicit accept/cancel icon buttons, since
		  // Enter needs to insert a newline instead of submitting. Each commit both updates the
		  // field's own <input>/<textarea> value (what "Save changes" ultimately submits) and
		  // autosaves it into the durable edit session, so a page reload mid-edit resumes from
		  // the last committed value rather than the volume's original one.
		  var sessionFieldsURL = document.getElementById('edit-form').dataset.sessionFieldsUrl;

		  function autosave(field, value) {
		    var body = {};
		    body[field] = value;
		    fetch(sessionFieldsURL, {
		      method: 'POST',
		      headers: { 'Content-Type': 'application/json' },
		      body: JSON.stringify(body),
		      credentials: 'include'
		    });
		  }

		  document.querySelectorAll('.field-row[data-field]').forEach(function (row) {
		    var field = row.dataset.field;
		    var type = row.dataset.fieldType;
		    var display = row.querySelector('.field-display');
		    var input = row.querySelector('.field-input');
		    var editBtn = row.querySelector('.field-edit-trigger');
		    var acceptBtn = row.querySelector('.field-accept-trigger');
		    var cancelBtn = row.querySelector('.field-cancel-trigger');
		    var originalValue = input.value;

		    function showEditing() {
		      display.hidden = true;
		      input.hidden = false;
		      editBtn.hidden = true;
		      if (acceptBtn) acceptBtn.hidden = false;
		      if (cancelBtn) cancelBtn.hidden = false;
		      input.focus();
		      if (type === 'line') input.select();
		    }

		    function commit() {
		      display.textContent = input.value;
		      display.hidden = false;
		      input.hidden = true;
		      editBtn.hidden = false;
		      if (acceptBtn) acceptBtn.hidden = true;
		      if (cancelBtn) cancelBtn.hidden = true;
		      autosave(field, input.value);
		    }

		    function cancel() {
		      input.value = originalValue;
		      display.hidden = false;
		      input.hidden = true;
		      editBtn.hidden = false;
		      if (acceptBtn) acceptBtn.hidden = true;
		      if (cancelBtn) cancelBtn.hidden = true;
		    }

		    editBtn.addEventListener('click', showEditing);
		    acceptBtn.addEventListener('click', commit);
		    cancelBtn.addEventListener('click', cancel);

		    if (type === 'line') {
		      input.addEventListener('keydown', function (e) {
		        if (e.key === 'Enter') {
		          e.preventDefault();
		          commit();
		        }
		      });
		      input.addEventListener('blur', function () {
		        // Deferred so a click on the accept/cancel button (which blurs the input first)
		        // runs its own commit()/cancel() before this fires - same pattern the
		        // publisher/studio picker's blur handler already uses below. Click-away is
		        // treated as "changed my mind": auto-cancel, not auto-save.
		        setTimeout(function () {
		          if (input.hidden) return;
		          cancel();
		        }, 150);
		      });
		    }
		  });
		})();
		</script>

		<script>
		(function () {
		  // Type-to-filter publisher/studio picker (task 7.1/7.2, tag-cloud rework): filters the
		  // full candidate list embedded as JSON at page load client-side (no search endpoint -
		  // existing entities only, per design.md), and there is deliberately no way to add a
		  // name that doesn't match an existing option. Each add/remove/edit sends the *full*
		  // resulting id list to the session (full-replace, same semantics PATCH itself uses for
		  // these fields). The filter row is hidden until "+" (add) or an existing tag (edit,
		  // swapping that tag for a different one in place) reveals it.
		  document.querySelectorAll('.picker-field').forEach(function (field) {
		    var sessionURL = field.dataset.sessionUrl;
		    var pickerKind = field.dataset.picker;
		    var fieldKey = pickerKind + 'Ids';
		    var chipList = field.querySelector('[data-chip-list]');
		    var addTrigger = field.querySelector('.chip-add-trigger');
		    var pickerRow = field.querySelector('.tag-picker');
		    var input = field.querySelector('.picker-filter');
		    var results = field.querySelector('.picker-results');
		    var cancelBtn = field.querySelector('.tag-picker-cancel');
		    var optionsScript = field.querySelector('.picker-options');
		    var options = [];
		    try { options = JSON.parse(optionsScript.textContent); } catch (e) {}

		    var editingChip = null;
		    var currentMatches = [];

		    function selectedIds() {
		      return Array.prototype.map.call(
		        chipList.querySelectorAll('.chip'), function (chip) { return chip.dataset.id; })
		        .filter(function (id) { return !editingChip || id !== editingChip.dataset.id; });
		    }

		    function autosave() {
		      var body = {};
		      body[fieldKey] = Array.prototype.map.call(
		        chipList.querySelectorAll('.chip'), function (chip) { return chip.dataset.id; });
		      fetch(sessionURL, {
		        method: 'POST',
		        headers: { 'Content-Type': 'application/json' },
		        body: JSON.stringify(body),
		        credentials: 'include'
		      });
		    }

		    function bindChip(chip) {
		      var label = chip.querySelector('.chip-label');
		      var removeBtn = chip.querySelector('.chip-remove');
		      label.addEventListener('click', function () { openPicker(chip); });
		      removeBtn.addEventListener('click', function (e) {
		        e.stopPropagation();
		        chip.remove();
		        autosave();
		      });
		    }

		    function addChip(option) {
		      var chip = document.createElement('span');
		      chip.className = 'chip';
		      chip.dataset.id = option.id;
		      chip.dataset.name = option.name;
		      var label = document.createElement('span');
		      label.className = 'chip-label';
		      label.textContent = option.name;
		      chip.appendChild(label);
		      var removeBtn = document.createElement('button');
		      removeBtn.type = 'button';
		      removeBtn.className = 'chip-remove';
		      removeBtn.title = 'Remove ' + option.name;
		      removeBtn.textContent = '×';
		      chip.appendChild(removeBtn);
		      bindChip(chip);
		      chipList.insertBefore(chip, addTrigger);
		      return chip;
		    }

		    chipList.querySelectorAll('.chip').forEach(bindChip);

		    function openPicker(chip) {
		      editingChip = chip || null;
		      addTrigger.hidden = true;
		      pickerRow.hidden = false;
		      input.value = editingChip ? editingChip.dataset.name : '';
		      input.focus();
		      input.select();
		      renderResults(input.value.trim());
		    }

		    function closePicker() {
		      editingChip = null;
		      pickerRow.hidden = true;
		      addTrigger.hidden = false;
		      input.value = '';
		      results.hidden = true;
		    }

		    function commit(option) {
		      if (editingChip) {
		        editingChip.dataset.id = option.id;
		        editingChip.dataset.name = option.name;
		        editingChip.querySelector('.chip-label').textContent = option.name;
		      } else {
		        addChip(option);
		      }
		      autosave();
		      closePicker();
		    }

		    addTrigger.addEventListener('click', function () { openPicker(null); });
		    cancelBtn.addEventListener('click', closePicker);

		    function renderResults(query) {
		      results.innerHTML = '';
		      currentMatches = [];
		      if (!query) {
		        results.hidden = true;
		        return;
		      }
		      var selected = selectedIds();
		      var needle = query.toLowerCase();
		      var matches = options.filter(function (option) {
		        return selected.indexOf(option.id) === -1
		          && option.name.toLowerCase().indexOf(needle) !== -1;
		      }).slice(0, 8);
		      currentMatches = matches;

		      if (matches.length === 0) {
		        results.hidden = true;
		        return;
		      }
		      matches.forEach(function (option) {
		        var item = document.createElement('li');
		        item.textContent = option.name;
		        item.addEventListener('click', function () { commit(option); });
		        results.appendChild(item);
		      });
		      results.hidden = false;
		    }

		    input.addEventListener('input', function () { renderResults(input.value.trim()); });
		    input.addEventListener('keydown', function (e) {
		      if (e.key === 'Enter') {
		        e.preventDefault();
		        if (currentMatches.length === 1) commit(currentMatches[0]);
		      } else if (e.key === 'Escape') {
		        e.preventDefault();
		        closePicker();
		      }
		    });
		    input.addEventListener('blur', function () {
		      // Deferred so a click on a result fires before the list disappears.
		      setTimeout(function () { results.hidden = true; }, 150);
		    });
		  });
		})();
		</script>

		<script>
		(function () {
		  // Contributor dialog (task 8.1/8.2): picks an existing person (type-to-filter, same
		  // no-create-new rationale as publisher/studio) and an existing contribution type
		  // (select-only for a submitter; editor/admin additionally gets an "add a new type"
		  // affordance that calls the vocabulary endpoint server-side, since the bearer token
		  // isn't available to this script). Confirming sends the *full* resulting credit list
		  // to the session, same full-replace semantics as the other pickers.
		  var field = document.getElementById('credits-field');
		  if (!field) return;

		  var sessionURL = field.dataset.sessionUrl;
		  var vocabularyURL = field.dataset.vocabularyUrl;
		  var chipList = field.querySelector('[data-chip-list]');
		  var dialog = document.getElementById('contributor-dialog');
		  var openBtn = document.getElementById('add-contributor-trigger');
		  var personFilter = document.getElementById('contributor-person-filter');
		  var personResults = document.getElementById('contributor-person-results');
		  var selectedPersonLabel = document.getElementById('contributor-selected-person');
		  var typeSelect = document.getElementById('contributor-type-select');
		  var newTypeInput = document.getElementById('contributor-new-type');
		  var addTypeBtn = document.getElementById('contributor-add-type-trigger');
		  var addTypeError = document.getElementById('contributor-add-type-error');
		  var confirmBtn = document.getElementById('contributor-confirm-trigger');
		  var cancelBtn = document.getElementById('contributor-cancel-trigger');

		  var personOptions = [];
		  try {
		    personOptions = JSON.parse(document.getElementById('contributor-person-options').textContent);
		  } catch (e) {}
		  var typeOptions = [];
		  try {
		    typeOptions = JSON.parse(document.getElementById('contributor-type-options').textContent);
		  } catch (e) {}

		  var selectedPerson = null;
		  var editingChip = null;

		  function renderTypeOptions() {
		    var current = typeSelect.value;
		    typeSelect.innerHTML = '<option value="">Select a type…</option>';
		    typeOptions.forEach(function (type) {
		      var option = document.createElement('option');
		      option.value = type;
		      option.textContent = type;
		      typeSelect.appendChild(option);
		    });
		    typeSelect.value = current;
		  }
		  renderTypeOptions();

		  function credits() {
		    return Array.prototype.map.call(chipList.querySelectorAll('.chip'), function (chip) {
		      return { personId: chip.dataset.personId, contributionType: chip.dataset.contributionType };
		    });
		  }

		  function autosave() {
		    fetch(sessionURL, {
		      method: 'POST',
		      headers: { 'Content-Type': 'application/json' },
		      body: JSON.stringify({ credits: credits() }),
		      credentials: 'include'
		    });
		  }

		  function bindChip(chip) {
		    chip.querySelector('.chip-label').addEventListener('click', function () {
		      openDialog(chip);
		    });
		    chip.querySelector('.chip-remove').addEventListener('click', function (e) {
		      e.stopPropagation();
		      chip.remove();
		      autosave();
		    });
		  }

		  function addChip(personId, personName, contributionType) {
		    var chip = document.createElement('span');
		    chip.className = 'chip';
		    chip.dataset.personId = personId;
		    chip.dataset.personName = personName;
		    chip.dataset.contributionType = contributionType;
		    var label = document.createElement('span');
		    label.className = 'chip-label';
		    label.textContent = personName + ' — ' + contributionType;
		    chip.appendChild(label);
		    var removeBtn = document.createElement('button');
		    removeBtn.type = 'button';
		    removeBtn.className = 'chip-remove';
		    removeBtn.title = 'Remove ' + personName;
		    removeBtn.textContent = '×';
		    chip.appendChild(removeBtn);
		    bindChip(chip);
		    chipList.insertBefore(chip, openBtn);
		  }

		  chipList.querySelectorAll('.chip').forEach(bindChip);

		  function updateConfirmEnabled() {
		    confirmBtn.disabled = !selectedPerson || !typeSelect.value;
		  }

		  function resetDialog() {
		    selectedPerson = null;
		    selectedPersonLabel.hidden = true;
		    selectedPersonLabel.textContent = '';
		    personFilter.value = '';
		    personResults.hidden = true;
		    typeSelect.value = '';
		    if (newTypeInput) newTypeInput.value = '';
		    if (addTypeError) addTypeError.hidden = true;
		    updateConfirmEnabled();
		  }

		  function openDialog(chip) {
		    resetDialog();
		    editingChip = chip || null;
		    if (editingChip) {
		      selectedPerson = { id: editingChip.dataset.personId, name: editingChip.dataset.personName };
		      selectedPersonLabel.textContent = 'Selected: ' + selectedPerson.name;
		      selectedPersonLabel.hidden = false;
		      var existingType = editingChip.dataset.contributionType;
		      // A chip's stored type can predate the current vocabulary (or come from a stale
		      // default like "Contributor") - inject it as a selectable option rather than let
		      // the select silently fall back to blank when it doesn't match any <option>.
		      if (existingType && !typeOptions.includes(existingType)) {
		        var extra = document.createElement('option');
		        extra.value = existingType;
		        extra.textContent = existingType;
		        typeSelect.appendChild(extra);
		      }
		      typeSelect.value = existingType;
		      updateConfirmEnabled();
		    }
		    confirmBtn.title = editingChip ? 'Update' : 'Add';
		    dialog.hidden = false;
		  }

		  function closeDialog() {
		    dialog.hidden = true;
		    editingChip = null;
		  }

		  openBtn.addEventListener('click', function () { openDialog(null); });
		  cancelBtn.addEventListener('click', closeDialog);
		  dialog.addEventListener('keydown', function (e) {
		    if (e.key === 'Enter') {
		      e.preventDefault();
		      if (!confirmBtn.disabled) confirmBtn.click();
		    } else if (e.key === 'Escape') {
		      e.preventDefault();
		      closeDialog();
		    }
		  });

		  var currentPersonMatches = [];

		  function selectPerson(option) {
		    selectedPerson = option;
		    selectedPersonLabel.textContent = 'Selected: ' + option.name;
		    selectedPersonLabel.hidden = false;
		    personFilter.value = '';
		    personResults.hidden = true;
		    updateConfirmEnabled();
		  }

		  function renderPersonResults(query) {
		    personResults.innerHTML = '';
		    currentPersonMatches = [];
		    if (!query) {
		      personResults.hidden = true;
		      return;
		    }
		    var needle = query.toLowerCase();
		    var matches = personOptions.filter(function (option) {
		      return option.name.toLowerCase().indexOf(needle) !== -1;
		    }).slice(0, 8);
		    currentPersonMatches = matches;

		    if (matches.length === 0) {
		      personResults.hidden = true;
		      return;
		    }
		    matches.forEach(function (option) {
		      var item = document.createElement('li');
		      item.textContent = option.name;
		      item.addEventListener('click', function () { selectPerson(option); });
		      personResults.appendChild(item);
		    });
		    personResults.hidden = false;
		  }

		  personFilter.addEventListener('input', function () { renderPersonResults(personFilter.value.trim()); });
		  personFilter.addEventListener('keydown', function (e) {
		    if (e.key === 'Enter') {
		      e.preventDefault();
		      if (currentPersonMatches.length === 1) selectPerson(currentPersonMatches[0]);
		    }
		  });
		  personFilter.addEventListener('blur', function () {
		    // Deferred so a click on a result fires first; also catches the case where the typed
		    // text is already an exact match but the user tabbed/clicked away instead of pressing
		    // Enter or clicking the suggestion - without this, Add silently stays disabled even
		    // though the field looks filled in.
		    setTimeout(function () {
		      personResults.hidden = true;
		      if (selectedPerson) return;
		      var needle = personFilter.value.trim().toLowerCase();
		      if (!needle) return;
		      var exact = personOptions.find(function (option) { return option.name.toLowerCase() === needle; });
		      if (exact) selectPerson(exact);
		    }, 150);
		  });

		  typeSelect.addEventListener('change', updateConfirmEnabled);

		  if (addTypeBtn) {
		    addTypeBtn.addEventListener('click', function () {
		      var value = newTypeInput.value.trim();
		      if (!value) return;
		      addTypeError.hidden = true;
		      fetch(vocabularyURL, {
		        method: 'POST',
		        headers: { 'Content-Type': 'application/json' },
		        body: JSON.stringify({ value: value }),
		        credentials: 'include'
		      })
		        .then(function (resp) {
		          if (!resp.ok) throw new Error('Failed to add contribution type');
		          return resp.json();
		        })
		        .then(function (data) {
		          typeOptions = data.values || typeOptions;
		          renderTypeOptions();
		          typeSelect.value = value;
		          newTypeInput.value = '';
		          updateConfirmEnabled();
		        })
		        .catch(function () {
		          addTypeError.textContent = 'Unable to add that contribution type. Try again.';
		          addTypeError.hidden = false;
		        });
		    });
		  }

		  confirmBtn.addEventListener('click', function () {
		    if (!selectedPerson || !typeSelect.value) return;
		    if (editingChip) {
		      editingChip.dataset.personId = selectedPerson.id;
		      editingChip.dataset.personName = selectedPerson.name;
		      editingChip.dataset.contributionType = typeSelect.value;
		      editingChip.querySelector('.chip-label').textContent =
		        selectedPerson.name + ' — ' + typeSelect.value;
		    } else {
		      addChip(selectedPerson.id, selectedPerson.name, typeSelect.value);
		    }
		    autosave();
		    closeDialog();
		  });
		})();
		</script>

		<script>
		(function () {
		  // Free-form property editing (task 9.2): pick an existing property name (select-only for
		  // a submitter; editor/admin additionally gets an "add a new name" affordance, same
		  // vocabulary-endpoint pattern as the contributor dialog's contribution type) plus a free
		  // text value. Confirming sends the *full* resulting property list to the session, same
		  // full-replace semantics as the other pickers.
		  var field = document.getElementById('properties-field');
		  if (!field) return;

		  var sessionURL = field.dataset.sessionUrl;
		  var vocabularyURL = field.dataset.vocabularyUrl;
		  var chipList = field.querySelector('[data-chip-list]');
		  var nameSelect = document.getElementById('property-name-select');
		  var valueInput = document.getElementById('property-value-input');
		  var addBtn = document.getElementById('property-add-trigger');
		  var newNameInput = document.getElementById('property-new-name');
		  var addNameBtn = document.getElementById('property-add-name-trigger');
		  var addNameError = document.getElementById('property-add-name-error');

		  var nameOptions = [];
		  try {
		    nameOptions = JSON.parse(document.getElementById('property-name-options').textContent);
		  } catch (e) {}

		  // Client-side counterpart of the server's propertyDisplayLabel: only the humanize half
		  // (no localization lookup available here) - a page reload picks up any localized label
		  // the server knows about. Property keys are always stored lowercase/dash-separated (see
		  // normalizePropertyKey below), so this only ever needs to reverse that, never guess at
		  // arbitrary input.
		  function humanizePropertyKey(key) {
		    return key.split('-').map(function (word) {
		      return word ? word.charAt(0).toUpperCase() + word.slice(1) : word;
		    }).join(' ');
		  }

		  function normalizePropertyKey(raw) {
		    return raw.trim().toLowerCase().split(/\s+/).filter(Boolean).join('-');
		  }

		  function renderNameOptions() {
		    var current = nameSelect.value;
		    nameSelect.innerHTML = '<option value="">Select a property…</option>';
		    nameOptions.forEach(function (name) {
		      var option = document.createElement('option');
		      option.value = name;
		      option.textContent = humanizePropertyKey(name);
		      nameSelect.appendChild(option);
		    });
		    nameSelect.value = current;
		  }
		  renderNameOptions();

		  function properties() {
		    return Array.prototype.map.call(chipList.querySelectorAll('.chip'), function (chip) {
		      return { name: chip.dataset.name, value: chip.dataset.value };
		    });
		  }

		  function autosave() {
		    fetch(sessionURL, {
		      method: 'POST',
		      headers: { 'Content-Type': 'application/json' },
		      body: JSON.stringify({ properties: properties() }),
		      credentials: 'include'
		    });
		  }

		  function addChip(name, value) {
		    var chip = document.createElement('span');
		    chip.className = 'chip';
		    chip.dataset.name = name;
		    chip.dataset.value = value;
		    chip.textContent = humanizePropertyKey(name) + ': ' + value;
		    var removeBtn = document.createElement('button');
		    removeBtn.type = 'button';
		    removeBtn.className = 'chip-remove';
		    removeBtn.title = 'Remove ' + humanizePropertyKey(name);
		    removeBtn.textContent = '×';
		    removeBtn.addEventListener('click', function () {
		      chip.remove();
		      autosave();
		    });
		    chip.appendChild(removeBtn);
		    chipList.appendChild(chip);
		  }

		  chipList.querySelectorAll('.chip-remove').forEach(function (btn) {
		    btn.addEventListener('click', function () {
		      btn.closest('.chip').remove();
		      autosave();
		    });
		  });

		  function updateAddEnabled() {
		    addBtn.disabled = !nameSelect.value || !valueInput.value.trim();
		  }
		  nameSelect.addEventListener('change', updateAddEnabled);
		  valueInput.addEventListener('input', updateAddEnabled);

		  addBtn.addEventListener('click', function () {
		    if (!nameSelect.value || !valueInput.value.trim()) return;
		    addChip(nameSelect.value, valueInput.value.trim());
		    autosave();
		    nameSelect.value = '';
		    valueInput.value = '';
		    updateAddEnabled();
		  });

		  if (addNameBtn) {
		    addNameBtn.addEventListener('click', function () {
		      var value = normalizePropertyKey(newNameInput.value);
		      if (!value) return;
		      addNameError.hidden = true;
		      fetch(vocabularyURL, {
		        method: 'POST',
		        headers: { 'Content-Type': 'application/json' },
		        body: JSON.stringify({ value: value }),
		        credentials: 'include'
		      })
		        .then(function (resp) {
		          if (!resp.ok) throw new Error('Failed to add property name');
		          return resp.json();
		        })
		        .then(function (data) {
		          nameOptions = data.values || nameOptions;
		          renderNameOptions();
		          nameSelect.value = value;
		          newNameInput.value = '';
		          updateAddEnabled();
		        })
		        .catch(function () {
		          addNameError.textContent = 'Unable to add that property name. Try again.';
		          addNameError.hidden = false;
		        });
		    });
		  }
		})();
		</script>

		<script>
		(function () {
		  // Sample-image staging (task 11.2/11.3) - each new file uploads immediately to
		  // assets-web as `sample-staged/<userSub>-<n>`, same staged-then-promoted pattern as the
		  // cover upload above. Capped at 5 staged samples client-side; catalog-api enforces the
		  // same cap server-side at finalize (task 4.4), so a crafted request past this UI can't
		  // exceed it either.
		  var MAX_SAMPLES = 5;
		  var MAX_UPLOAD_BYTES = 5 * 1024 * 1024;
		  var ALLOWED_CONTENT_TYPES = ['image/png', 'image/jpeg', 'image/webp'];

		  var field = document.getElementById('samples-field');
		  if (!field) return;

		  var assetsURL = field.dataset.assetsUrl;
		  var userSub = field.dataset.userSub;
		  var sessionURL = field.dataset.sessionUrl;
		  var list = document.getElementById('staged-sample-list');
		  var input = document.getElementById('sample-upload-input');
		  var uploadTrigger = document.getElementById('sample-upload-trigger');
		  var errorEl = document.getElementById('sample-upload-error');

		  var nextIndex = list.querySelectorAll('.chip').length;

		  function showError(message) {
		    errorEl.textContent = message;
		    errorEl.hidden = false;
		  }

		  function clearError() {
		    errorEl.hidden = true;
		    errorEl.textContent = '';
		  }

		  function stagedIds() {
		    return Array.prototype.map.call(
		      list.querySelectorAll('.chip'), function (chip) { return chip.dataset.id; });
		  }

		  function autosave() {
		    fetch(sessionURL, {
		      method: 'POST',
		      headers: { 'Content-Type': 'application/json' },
		      body: JSON.stringify({ sampleAssetIds: stagedIds() }),
		      credentials: 'include'
		    });
		  }

		  function updateUploadEnabled() {
		    var atCap = stagedIds().length >= MAX_SAMPLES;
		    uploadTrigger.setAttribute('aria-disabled', atCap ? 'true' : 'false');
		    input.disabled = atCap;
		  }
		  updateUploadEnabled();

		  function addChip(id, path) {
		    var chip = document.createElement('span');
		    chip.className = 'chip';
		    chip.dataset.id = id;
		    var thumb = document.createElement('img');
		    thumb.className = 'chip-thumbnail';
		    thumb.src = assetsURL + '/' + path;
		    thumb.alt = 'Staged sample';
		    chip.appendChild(thumb);
		    var removeBtn = document.createElement('button');
		    removeBtn.type = 'button';
		    removeBtn.className = 'chip-remove';
		    removeBtn.title = 'Remove this sample';
		    removeBtn.textContent = '×';
		    removeBtn.addEventListener('click', function () {
		      chip.remove();
		      autosave();
		      updateUploadEnabled();
		    });
		    chip.appendChild(removeBtn);
		    list.appendChild(chip);
		  }

		  list.querySelectorAll('.chip-remove').forEach(function (btn) {
		    btn.addEventListener('click', function () {
		      btn.closest('.chip').remove();
		      autosave();
		      updateUploadEnabled();
		    });
		  });

		  input.addEventListener('change', function () {
		    var file = input.files[0];
		    if (!file) return;
		    clearError();

		    if (stagedIds().length >= MAX_SAMPLES) {
		      showError('A volume may have at most ' + MAX_SAMPLES + ' samples.');
		      input.value = '';
		      return;
		    }
		    if (ALLOWED_CONTENT_TYPES.indexOf(file.type) === -1) {
		      showError('Samples must be PNG, JPEG, or WEBP images.');
		      input.value = '';
		      return;
		    }
		    if (file.size > MAX_UPLOAD_BYTES) {
		      showError('Samples must be 5 MB or smaller.');
		      input.value = '';
		      return;
		    }

		    var id = userSub + '-' + nextIndex;
		    var path = 'asset/sample-staged/' + id;
		    var formData = new FormData();
		    formData.append('file', file);

		    fetch(assetsURL + '/' + path, { method: 'POST', body: formData, credentials: 'include' })
		      .then(function (resp) {
		        if (!resp.ok) throw new Error('Sample upload failed');
		        nextIndex += 1;
		        addChip(id, path);
		        autosave();
		        updateUploadEnabled();
		        input.value = '';
		      })
		      .catch(function () {
		        showError('Sample upload failed. Try again.');
		        input.value = '';
		      });
		  });
		})();
		</script>

		<script>
		(function () {
		  // Best-effort reclaim of a staged cover before discarding - assets-web only accepts
		  // browser-originated requests (its auth comes from the ingress, not this app's own
		  // server-to-server calls), so this has to run client-side. The periodic reclaim job
		  // (assets-web) is the durable backstop if this never fires (JS disabled, tab closed
		  // mid-request, etc.) - see durable-volume-editing task 2.4 in sweetrpg/platform.
		  var form = document.getElementById('discard-form');
		  if (!form) return;

		  form.addEventListener('submit', function () {
		    var url = form.dataset.assetsUrl + '/' + form.dataset.stagedCoverPath;
		    fetch(url, { method: 'DELETE', credentials: 'include', keepalive: true }).catch(function () {});
		  });
		})();
		</script>

		#if(canUploadCover):
			<script>
			(function () {
			  var MAX_UPLOAD_BYTES = 5 * 1024 * 1024;
			  var ALLOWED_CONTENT_TYPES = ['image/png', 'image/jpeg', 'image/webp'];

			  var container = document.querySelector('.cover-overlay-controls');
			  if (!container) return;

			  var input = document.getElementById('cover-upload-input');
			  var removeBtn = document.getElementById('cover-remove-trigger');
			  var errorEl = document.querySelector('.cover-upload-error');
			  var coverImg = document.getElementById('cover-preview-img');
			  var uploadURL = container.dataset.assetsUrl + '/' + container.dataset.stagedCoverPath;
			  var livePath = container.dataset.liveCoverPath;
			  var liveURL = container.dataset.assetsUrl + '/' + livePath;
			  var sessionCoverURL = container.dataset.sessionCoverUrl;

			  function showError(message) {
			    errorEl.textContent = message;
			    errorEl.hidden = false;
			  }

			  function clearError() {
			    errorEl.hidden = true;
			    errorEl.textContent = '';
			  }

			  // Unlike the old client-side-only preview, selecting a file uploads it to
			  // assets-web immediately (as a *staged* copy, cover-staged/<userSub> - not the
			  // volume's live cover) and records the staging in the edit session. Finalize (or a
			  // reviewer's accept) promotes it to live; discarding or letting the session expire
			  // reclaims it. See durable-volume-editing's volume-cover-staging spec.
			  input.addEventListener('change', function () {
			    var file = input.files[0];
			    if (!file) return;
			    clearError();

			    if (ALLOWED_CONTENT_TYPES.indexOf(file.type) === -1) {
			      showError('Cover must be a PNG, JPEG, or WEBP image.');
			      input.value = '';
			      return;
			    }
			    if (file.size > MAX_UPLOAD_BYTES) {
			      showError('Cover must be 5 MB or smaller.');
			      input.value = '';
			      return;
			    }

			    var formData = new FormData();
			    formData.append('file', file);

			    fetch(uploadURL, { method: 'POST', body: formData, credentials: 'include' })
			      .then(function (resp) {
			        if (!resp.ok) throw new Error('Cover upload failed');
			        return fetch(sessionCoverURL, {
			          method: 'POST',
			          headers: { 'Content-Type': 'application/json' },
			          body: JSON.stringify({ assetId: container.dataset.stagedCoverPath.split('/').pop() }),
			          credentials: 'include'
			        });
			      })
			      .then(function (resp) {
			        if (!resp.ok) throw new Error('Failed to record staged cover');
			        if (coverImg) {
			          coverImg.style.display = '';
			          coverImg.src = uploadURL + '?t=' + Date.now();
			        }
			        removeBtn.hidden = false;
			      })
			      .catch(function () {
			        showError('Cover upload failed. Try again.');
			        input.value = '';
			      });
			  });

			  // Only a *staged* (not-yet-saved) cover can be removed here - there's no way today
			  // to clear an already-live cover to none, only to replace it with a new upload.
			  removeBtn.addEventListener('click', function () {
			    clearError();
			    fetch(uploadURL, { method: 'DELETE', credentials: 'include' }).catch(function () {});
			    fetch(sessionCoverURL, {
			      method: 'POST',
			      headers: { 'Content-Type': 'application/json' },
			      body: JSON.stringify({ assetId: '' }),
			      credentials: 'include'
			    })
			      .then(function (resp) {
			        if (!resp.ok) throw new Error('Failed to clear staged cover');
			        if (coverImg) coverImg.src = liveURL + '?t=' + Date.now();
			        removeBtn.hidden = true;
			        input.value = '';
			      })
			      .catch(function () {
			        showError('Unable to remove the staged cover. Try again.');
			      });
			  });
			})();
			</script>
		#endif
	#endexport
#endextend
