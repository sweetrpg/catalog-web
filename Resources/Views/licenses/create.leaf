#extend("base"):
	#export("body"):
		<a class="back-link" href="#(meta.basePath)#(backPath)">&larr; #(meta.l10n.entity.licenses)</a>

		<section class="page-header">
			<span class="section-label">#(meta.l10n.common.new)</span>
			<h2>#(meta.l10n.entity.license)</h2>
		</section>

		<form class="form" action="#(meta.basePath)#(submitPath)" method="post">
			#for(field in fields):
				<label class="form-label" for="#(field.key)">#(field.label)</label>
				#if(field.isTextarea):
					<textarea class="input" id="#(field.key)" name="#(field.key)" rows="8">#(field.value)</textarea>
				#elseif(field.isSelect):
					<select class="input" id="#(field.key)" name="#(field.key)">
						#for(option in field.selectOptions):
							<option value="#(option.value)" #if(option.isSelected): selected #endif>#(option.value)</option>
						#endfor
					</select>
				#else:
					<input class="input" type="text" id="#(field.key)" name="#(field.key)" value="#(field.value)">
				#endif
			#endfor

			<div class="form-actions">
				<button type="submit" class="btn btn-primary">#(meta.l10n.common.create)</button>
				<a class="btn btn-ghost" href="#(meta.basePath)#(backPath)">#(meta.l10n.common.cancel)</a>
			</div>
		</form>
	#endexport
#endextend
