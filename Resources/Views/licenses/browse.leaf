#extend("base"):
	#export("body"):
		<style>
		  /* Page-specific: a slight app-accent tint on each card background - purely decorative,
		     no shared-web equivalent to reuse. */
		  .license-card {
		    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-surface));
		  }
		  .license-card-meta {
		    display: flex;
		    align-items: center;
		    gap: 8px;
		    margin-top: 6px;
		  }
		</style>

		<section class="page-header">
			<span class="section-label">Browse</span>
			<h2>Licenses</h2>
			<form class="nav-search" action="#(meta.basePath)/licenses" method="get">
				<input class="input" type="search" name="q" placeholder="Search licenses" value="#(query)">
				<select class="input" name="order" onchange="this.form.submit()">
					<option value="asc" #if(orderIsAsc): selected #endif>Title (A-Z)</option>
					<option value="desc" #if(orderIsDesc): selected #endif>Title (Z-A)</option>
				</select>
			</form>
			#if(canEdit):
				<a class="btn btn-primary" href="#(meta.basePath)/licenses/new">Add license</a>
			#endif
		</section>

		#if(noResults):
			<p class="empty-state">No licenses match "#(query)".</p>
		#endif

		<div class="card-grid">
			#for(item in items):
				<a class="card license-card" href="#(meta.basePath)/licenses/#(item.id)">
					<div class="card-body">
						<div class="card-title">#(item.title)</div>
						<div class="license-card-meta">
							<span class="card-meta">#(item.volumeCountLabel)</span>
							#if(item.isNotAccepted):
								<span class="tag tag-neutral">Not accepted</span>
							#endif
						</div>
					</div>
				</a>
			#endfor
		</div>
	#endexport
#endextend
