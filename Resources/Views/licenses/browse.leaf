#extend("base"):
	#export("body"):
		<style>
		  /* Page-specific: a slight app-accent tint on each card background - purely decorative,
		     no shared-web equivalent to reuse. */
		  .license-card {
		    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-surface));
		  }
		  .license-card-meta {
		    display: flex;
		    align-items: center;
		    gap: 8px;
		    margin-top: 6px;
		  }
		</style>

		<section class="page-header">
			<span class="section-label">#(meta.l10n.common.browse)</span>
			<h2>#(meta.l10n.entity.licenses)</h2>
			<div class="page-header-toolbar">
				<form class="nav-search" action="#(meta.basePath)/licenses" method="get">
					<input class="input" type="search" name="q" placeholder="#(meta.l10n.licenses.search_placeholder)" value="#(query)">
					<select class="input" name="order" onchange="this.form.submit()">
						<option value="asc" #if(orderIsAsc): selected #endif>#(meta.l10n.licenses.order_asc)</option>
						<option value="desc" #if(orderIsDesc): selected #endif>#(meta.l10n.licenses.order_desc)</option>
					</select>
				</form>
				#if(canEdit):
					<a class="btn btn-primary" href="#(meta.basePath)/licenses/new">#(meta.l10n.licenses.add)</a>
				#endif
			</div>
		</section>

		#if(noResults):
			<p class="empty-state">#(meta.l10n.licenses.no_results_prefix)#(query)#(meta.l10n.licenses.no_results_suffix)</p>
		#endif

		<div class="card-grid">
			#for(item in items):
				<a class="card license-card" href="#(meta.basePath)/licenses/#(item.id)">
					<div class="card-body">
						<div class="card-title">#(item.title)</div>
						<div class="license-card-meta">
							<span class="card-meta">#(item.volumeCountLabel)</span>
							#if(item.isNotAccepted):
								<span class="tag tag-neutral">#(meta.l10n.licenses.not_accepted)</span>
							#endif
						</div>
					</div>
				</a>
			#endfor
		</div>

		#extend("partials/pagination")
	#endexport
#endextend
