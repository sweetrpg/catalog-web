#extend("base"):
	#export("body"):
		<style>
		  /* Page-specific: these classes have no shared-web equivalent, unlike .detail-layout/
		     .card-cover which volumes reuse - a license's shape (label/value metadata pairs,
		     long-form legal text) doesn't match the volume detail page's layout closely enough
		     to share it. */
		  .license-columns {
		    display: grid;
		    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
		    gap: 40px;
		    margin-top: 24px;
		    align-items: start;
		  }
		  .license-meta {
		    display: grid;
		    grid-template-columns: auto 1fr;
		    gap: 6px 16px;
		    align-items: baseline;
		  }
		  .license-meta-label {
		    font-size: 13px;
		    letter-spacing: 0.04em;
		    text-transform: uppercase;
		    opacity: 0.55;
		  }
		  .license-notes {
		    white-space: pre-wrap;
		  }
		  .license-volumes-panel {
		    margin-top: 12px;
		  }
		  .license-text-panel details {
		    /* Some UA stylesheets give <details> an implicit block margin like <p>/<blockquote> -
		       zero it explicitly so "License Text"'s section-label margin is the only gap above
		       the first toggle, instead of stacking with a second, invisible one. */
		    margin: 0;
		  }
		  .license-text-panel details + details {
		    margin-top: 12px;
		    border-top: 1px solid var(--color-divider);
		    padding-top: 12px;
		  }
		  .license-text-panel summary {
		    cursor: pointer;
		    font-weight: var(--font-heading-weight);
		  }
		  .license-text-body {
		    white-space: pre-wrap;
		    font-size: 14px;
		    line-height: 1.6;
		    max-height: 60vh;
		    overflow-y: auto;
		    /* A <p>'s UA-stylesheet margin (~1em top/bottom) was adding visible blank space above
		       and below the text inside this scroll container - reset both, keep only the
		       deliberate gap below the <summary> toggle. */
		    margin: 8px 0 0;
		  }
		  .license-text-body[data-mode="preview"] {
		    white-space: normal;
		  }
		  .license-text-mode-toggle {
		    display: inline-flex;
		    gap: 4px;
		    margin-left: 12px;
		  }
		  .license-text-mode-toggle button {
		    border: none;
		    background: rgba(127, 127, 127, 0.12);
		    border-radius: 999px;
		    padding: 2px 10px;
		    font-size: 12px;
		    cursor: pointer;
		  }
		  .license-text-mode-toggle button[aria-pressed="true"] {
		    background: var(--color-accent);
		    color: var(--color-on-accent, #fff);
		  }
		</style>

		<a class="back-link" href="#(meta.basePath)/licenses">&larr; Licenses</a>

		#if(justProposed):
			<p class="empty-state-inline">Your change was submitted for review and hasn't been applied yet.</p>
		#endif

		#if(count(conflicts) > 0):
			<p class="form-error">Some changes weren't applied because the live record changed since the proposal was submitted: #for(field in conflicts):#(field) #endfor</p>
		#endif

		#if(isDeleted):
			<p class="form-error">This license is deleted. It's hidden from browse, search, and pickers, but stays reachable here directly.</p>
		#endif

		<div>
			<span class="section-label">License</span>
			<h1>#(license.title)</h1>

			#if(canEdit):
				<a class="btn btn-ghost" href="#(meta.basePath)/licenses/#(license.id)/edit">Edit</a>
			#endif

			#if(canDelete):
				#if(isDeleted):
					<form method="post" action="#(meta.basePath)/licenses/#(license.id)/undelete">
						<button type="submit" class="btn btn-ghost">Restore</button>
					</form>
				#else:
					<form method="post" action="#(meta.basePath)/licenses/#(license.id)/delete" onsubmit="return confirm('Delete this license? It will be hidden from browse and pickers, but can be restored later.')">
						<button type="submit" class="btn btn-ghost">Delete</button>
					</form>
				#endif
			#endif

			#if(review):
				<div class="detail-block">
					<span class="section-label">Pending Changes (#(review.pendingCount))</span>

					#if(review.hasMultiplePending):
						<form class="proposal-picker" method="get" action="#(meta.basePath)/licenses/#(license.id)">
							<label class="form-label" for="proposal">Viewing proposal from</label>
							<select class="input" id="proposal" name="proposal" onchange="this.form.submit()">
								#for(option in review.options):
									<option value="#(option.version)" #if(option.isSelected): selected #endif>#(option.submittedBy) &mdash; #(option.submittedAtLabel)</option>
								#endfor
							</select>
						</form>
					#else:
						<p class="empty-state-inline">Proposed by #(review.submittedBy) on #(review.submittedAtLabel).</p>
					#endif

					<form class="proposal-diff" method="post" action="#(meta.basePath)/licenses/#(license.id)/versions/#(review.selectedVersion)/accept">
						<input type="hidden" name="mode" value="subset">
						<table class="table">
							<thead>
								<tr>
									<th></th>
									<th>Field</th>
									<th>Live value</th>
									<th>Proposed value</th>
								</tr>
							</thead>
							<tbody>
								#for(field in review.fields):
									<tr>
										<td><input type="checkbox" name="fields" value="#(field.key)"></td>
										<td>#(field.label)</td>
										<td>#(field.oldValue)</td>
										<td>#(field.newValue)</td>
									</tr>
								#endfor
							</tbody>
						</table>
						<div class="form-actions table-actions">
							<button type="submit" class="btn btn-ghost">Accept Selected</button>
						</div>
					</form>

					<div class="table-actions">
						<form method="post" action="#(meta.basePath)/licenses/#(license.id)/versions/#(review.selectedVersion)/accept">
							<input type="hidden" name="mode" value="all">
							<button type="submit" class="btn btn-primary">Accept All</button>
						</form>
						<form method="post" action="#(meta.basePath)/licenses/#(license.id)/versions/#(review.selectedVersion)/reject">
							<input class="input" type="text" name="note" placeholder="Optional note">
							<button type="submit" class="btn btn-ghost">Reject</button>
						</form>
					</div>
				</div>
			#endif

			<div class="license-columns">
				<div class="license-meta">
					#if(license.hasShortTitle):
						<span class="license-meta-label">Short title</span>
						<span class="license-meta-value">#(license.shortTitle)</span>
					#endif

					#if(license.hasVersion):
						<span class="license-meta-label">Version</span>
						<span class="license-meta-value">#(license.version)</span>
					#endif

					#if(license.hasStatus):
						<span class="license-meta-label">Status</span>
						<span class="license-meta-value">#(license.status)</span>
					#endif

					#if(license.hasAvailability):
						<span class="license-meta-label">Availability</span>
						<span class="license-meta-value">#(license.availability)</span>
					#endif

					#if(license.hasWebsite):
						<span class="license-meta-label">Website</span>
						<span class="license-meta-value"><a href="#(license.website)">#(license.website)</a></span>
					#endif

					#for(property in license.properties):
						<span class="license-meta-label">#(property.displayLabel)</span>
						<span class="license-meta-value">#(property.value)</span>
					#endfor

					#if(license.hasNotes):
						<span class="license-meta-label">Notes</span>
						<div class="license-meta-value license-notes">#(license.notes)</div>
					#endif

					#if(license.hasTags):
						<span class="license-meta-label">Tags</span>
						<div class="license-meta-value tag-cloud">
							#for(tag in license.tags):
								<span class="tag tag-accent">#(tag)</span>
							#endfor
						</div>
					#endif
				</div>

				<div class="license-volumes">
					<span class="section-label">Volumes</span>
					#if(license.hasVolumes):
						<div class="license-volumes-panel">
							<div class="card-grid">
								#for(volume in license.volumes):
									<a class="card" href="#(meta.basePath)/volumes/#(volume.id)">
										<div class="card-body">
											<div class="card-title">#(volume.title)</div>
										</div>
									</a>
								#endfor
							</div>
						</div>
					#else:
						<p class="empty-state-inline">No volumes associated with this license yet.</p>
					#endif
				</div>
			</div>

			#if(license.hasDeed || license.hasLegalCode):
				<div class="detail-block">
					<span class="section-label">License Text</span>
					<div class="license-text-panel">
						#if(license.hasDeed):
							<details open>
								<summary>Deed
									<span class="license-text-mode-toggle" data-license-text-toggle>
										<button type="button" data-mode="preview" aria-pressed="true">Preview</button>
										<button type="button" data-mode="raw" aria-pressed="false">Raw</button>
									</span>
								</summary>
								<p class="license-text-body" data-mode="preview" data-raw="#(license.deed)">#(license.deed)</p>
							</details>
						#endif
						#if(license.hasLegalCode):
							<details>
								<summary>Legal code
									<span class="license-text-mode-toggle" data-license-text-toggle>
										<button type="button" data-mode="preview" aria-pressed="true">Preview</button>
										<button type="button" data-mode="raw" aria-pressed="false">Raw</button>
									</span>
								</summary>
								<p class="license-text-body" data-mode="preview" data-raw="#(license.legalCode)">#(license.legalCode)</p>
							</details>
						#endif
					</div>
				</div>
			#endif
		</div>

		<script>
		(function () {
		  // Deed/legal code preview toggle: renders a small, dependency-free Markdown subset
		  // (headers, bold/italic, links, lists, paragraphs) client-side rather than pulling in
		  // a Swift Markdown package - this text is admin-authored license text, not
		  // user-submitted, but it's still escaped first so a raw '<'/'&' in the source can't
		  // break out of the rendered HTML.
		  function escapeHTML(text) {
		    return text
		      .replace(/&/g, '&amp;')
		      .replace(/</g, '&lt;')
		      .replace(/>/g, '&gt;');
		  }

		  function renderInline(text) {
		    return escapeHTML(text)
		      .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2" rel="noopener">$1</a>')
		      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
		      .replace(/\*([^*]+)\*/g, '<em>$1</em>');
		  }

		  function renderMarkdown(text) {
		    var lines = text.split(/\r?\n/);
		    var html = '';
		    var listOpen = false;
		    lines.forEach(function (line) {
		      var heading = line.match(/^(#{1,6})\s+(.*)$/);
		      var listItem = line.match(/^\s*[-*]\s+(.*)$/);
		      if (heading) {
		        if (listOpen) { html += '</ul>'; listOpen = false; }
		        var level = heading[1].length;
		        html += '<h' + level + '>' + renderInline(heading[2]) + '</h' + level + '>';
		      } else if (listItem) {
		        if (!listOpen) { html += '<ul>'; listOpen = true; }
		        html += '<li>' + renderInline(listItem[1]) + '</li>';
		      } else if (line.trim() === '') {
		        if (listOpen) { html += '</ul>'; listOpen = false; }
		      } else {
		        if (listOpen) { html += '</ul>'; listOpen = false; }
		        html += '<p>' + renderInline(line) + '</p>';
		      }
		    });
		    if (listOpen) html += '</ul>';
		    return html;
		  }

		  document.querySelectorAll('.license-text-body').forEach(function (body) {
		    body.innerHTML = renderMarkdown(body.dataset.raw);
		  });

		  document.querySelectorAll('[data-license-text-toggle]').forEach(function (toggle) {
		    var body = toggle.closest('details').querySelector('.license-text-body');
		    var buttons = toggle.querySelectorAll('button');
		    buttons.forEach(function (button) {
		      button.addEventListener('click', function (e) {
		        e.preventDefault();
		        var mode = button.dataset.mode;
		        body.dataset.mode = mode;
		        body.innerHTML = mode === 'raw'
		          ? escapeHTML(body.dataset.raw).replace(/\n/g, '<br>')
		          : renderMarkdown(body.dataset.raw);
		        buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b === button)); });
		      });
		    });
		  });
		})();
		</script>
	#endexport
#endextend
