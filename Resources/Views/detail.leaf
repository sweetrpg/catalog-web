#extend("base"):
	#export("body"):
		<style>
		  /* Page-specific: header action icons (upper-right of the title) and the description's
		     Markdown-rendered, scrollable body - shared-web owns the global stylesheet, neither
		     is common enough elsewhere to belong there. */
		  .detail-header-row {
		    display: flex;
		    align-items: flex-start;
		    justify-content: space-between;
		    gap: 12px;
		  }
		  .detail-header-actions {
		    display: flex;
		    gap: 6px;
		    flex-shrink: 0;
		  }
		  .detail-header-actions .icon-btn {
		    width: 2rem;
		    height: 2rem;
		    border-radius: 50%;
		    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
		  }
		  .detail-header-actions .icon-btn:hover {
		    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
		  }
		  .detail-description {
		    max-height: 20vh;
		    overflow-y: auto;
		  }
		  .detail-description :first-child {
		    margin-top: 0;
		  }
		  .detail-description :last-child {
		    margin-bottom: 0;
		  }
		</style>

		<a class="back-link" href="#(meta.basePath)/browse">&larr; Browse the stacks</a>

		#if(justProposed):
			<p class="empty-state-inline">Your change was submitted for review and hasn't been applied yet.</p>
		#endif

		#if(hasConflicts):
			<p class="form-error">Some changes weren't applied because the live record changed since the proposal was submitted: #for(field in conflicts):#(field) #endfor</p>
		#endif

		#if(isDeleted):
			<p class="form-error">This volume is deleted. It's hidden from browse, search, and pickers, but stays reachable here directly.</p>
		#endif

		<div class="detail-layout">
			<div class="card-cover detail-cover">
				<img class="card-cover-img" src="#(meta.assetsURL)/#(volume.coverAssetPath)" alt="#(volume.title)" loading="lazy" onerror="this.onerror=null;this.src='#(meta.sharedURL)/static/img/catalog/cover-placeholder-detail.png'">
			</div>

			<div>
				<div class="detail-header-row">
					<h1>#(volume.title)</h1>
					<span class="detail-header-actions">
						#if(canEdit):
							<a class="icon-btn" href="#(meta.basePath)/volumes/#(volume.id)/edit" title="Edit">
								<img src="#(meta.sharedURL)/static/img/icons/edit.svg" alt="Edit">
							</a>
						#endif
						<a class="icon-btn" href="#(meta.basePath)/volumes/#(volume.id)/versions" title="Version History">
							<img src="#(meta.sharedURL)/static/img/icons/history.svg" alt="Version History">
						</a>
						#if(canDelete):
							#if(isDeleted):
								<form method="post" action="#(meta.basePath)/volumes/#(volume.id)/undelete">
									<button type="submit" class="icon-btn" title="Restore">
										<img src="#(meta.sharedURL)/static/img/icons/restore.svg" alt="Restore" onerror="this.replaceWith('↺')">
									</button>
								</form>
							#else:
								<form method="post" action="#(meta.basePath)/volumes/#(volume.id)/delete" onsubmit="return confirm('Delete this volume? It will be hidden from browse and pickers, but can be restored later.')">
									<button type="submit" class="icon-btn" title="Delete">
										<img src="#(meta.sharedURL)/static/img/icons/delete.svg" alt="Delete" onerror="this.replaceWith('×')">
									</button>
								</form>
							#endif
						#endif
					</span>
				</div>
				<div class="tag-cloud">
					#for(tag in volume.tags):
						<span class="tag tag-accent">#(tag)</span>
					#endfor
				</div>

				#if(volume.hasDescription):
					<div class="detail-description">#unsafeHTML(volume.descriptionHTML)</div>
				#else:
					<p class="detail-description detail-description-empty">No description on file yet for this volume.</p>
				#endif

				#if(volume.hasNotes):
					<p class="detail-notes"><strong>Notes:</strong> #(volume.notes)</p>
				#endif

				#if(volume.hasSystemNames):
					<div class="detail-block">
						<span class="section-label">System</span>
						<div class="tag-cloud">
							#for(name in volume.systemNames):
								<span class="tag tag-neutral">#(name)</span>
							#endfor
						</div>
					</div>
				#endif

				#if(volume.hasPublisherNames):
					<div class="detail-block">
						<span class="section-label">Publisher</span>
						<div class="tag-cloud">
							#for(ref in volume.publisherRefs):
								<a class="tag tag-neutral" href="#(meta.basePath)/publishers/#(ref.id)">#(ref.name)#if(ref.isDeleted): (deleted)#endif</a>
							#endfor
						</div>
					</div>
				#endif

				#if(volume.hasStudioNames):
					<div class="detail-block">
						<span class="section-label">Studio</span>
						<div class="tag-cloud">
							#for(ref in volume.studioRefs):
								<a class="tag tag-neutral" href="#(meta.basePath)/studios/#(ref.id)">#(ref.name)#if(ref.isDeleted): (deleted)#endif</a>
							#endfor
						</div>
					</div>
				#endif

				#if(volume.hasLicenseNames):
					<div class="detail-block">
						<span class="section-label">License</span>
						<div class="tag-cloud">
							#for(ref in volume.licenseRefs):
								<a class="tag tag-neutral" href="#(meta.basePath)/licenses/#(ref.id)">#(ref.name)#if(ref.isDeleted): (deleted)#endif</a>
							#endfor
						</div>
					</div>
				#endif

				#if(volume.hasCredits):
					<div class="detail-block">
						<span class="section-label">Credits</span>
						#for(credit in volume.credits):
							<p><strong>#(credit.person)</strong> &mdash; #(credit.role)</p>
						#endfor
					</div>
				#endif

				#if(volume.hasProperties):
					<div class="detail-block">
						<span class="section-label">Properties</span>
						<table class="table">
							<tbody>
								#for(property in volume.properties):
									<tr>
										<td>#(property.displayLabel)</td>
										<td>#(property.value)</td>
									</tr>
								#endfor
							</tbody>
						</table>
					</div>
				#endif

				#if(volume.hasSamples):
					<div class="detail-block">
						<span class="section-label">Sample Pages</span>
						<div class="sample-thumbnails" id="sample-thumbnails">
							#for(path in volume.samplePaths):
								<img class="sample-thumbnail" src="#(meta.assetsURL)/#(path)" alt="Sample page" loading="lazy">
							#endfor
						</div>
					</div>
				#endif

				#if(review):
					<div class="detail-block">
						<span class="section-label">Pending Changes (#(review.pendingCount))</span>

						#if(review.hasMultiplePending):
							<form class="proposal-picker" method="get" action="#(meta.basePath)/volumes/#(volume.id)">
								<label class="form-label" for="proposal">Viewing proposal from</label>
								<select class="input" id="proposal" name="proposal" onchange="this.form.submit()">
									#for(option in review.options):
										<option value="#(option.version)" #if(option.isSelected): selected #endif>#(option.submittedBy) &mdash; #(option.submittedAtLabel)</option>
									#endfor
								</select>
							</form>
						#else:
							<p class="empty-state-inline">Proposed by #(review.submittedBy) on #(review.submittedAtLabel).</p>
						#endif

						<form class="proposal-diff" method="post" action="#(meta.basePath)/volumes/#(volume.id)/versions/#(review.selectedVersion)/accept">
							<input type="hidden" name="mode" value="subset">
							<table class="table">
								<thead>
									<tr>
										<th></th>
										<th>Field</th>
										<th>Live value</th>
										<th>Proposed value</th>
									</tr>
								</thead>
								<tbody>
									#for(field in review.fields):
										<tr>
											<td><input type="checkbox" name="fields" value="#(field.key)"></td>
											<td>#(field.label)</td>
											<td>#(field.oldValue)</td>
											<td>#(field.newValue)</td>
										</tr>
									#endfor
								</tbody>
							</table>
							<div class="form-actions table-actions">
								<button type="submit" class="btn btn-ghost">Accept Selected</button>
							</div>
						</form>

						<div class="table-actions">
							<form method="post" action="#(meta.basePath)/volumes/#(volume.id)/versions/#(review.selectedVersion)/accept">
								<input type="hidden" name="mode" value="all">
								<button type="submit" class="btn btn-primary">Accept All</button>
							</form>
							<form method="post" action="#(meta.basePath)/volumes/#(volume.id)/versions/#(review.selectedVersion)/reject">
								<input class="input" type="text" name="note" placeholder="Optional note">
								<button type="submit" class="btn btn-ghost">Reject</button>
							</form>
						</div>
					</div>
				#endif

				<!-- Shelf status, rating, and review will move here once shelf-api is wired up
				     (see ShelfAPIClient) - the design's prototype has this as browser-local
				     state today; this app doesn't persist anything client-side. -->
				<div class="detail-block">
					<span class="section-label">Your Shelf</span>
					<p class="empty-state-inline">Sign in and shelf tracking will appear here once shelf-api is connected.</p>
				</div>

				<div class="detail-block">
					<span class="section-label">Community Reviews</span>
					#if(volume.hasReviews):
						#for(review in volume.reviews):
							<div class="review">
								<p><strong>#(review.author)</strong> <span class="review-stars">#(review.starsLabel)</span></p>
								<p>#(review.text)</p>
							</div>
						#endfor
					#else:
						<p class="empty-state-inline">No reviews yet - be the first at the table to weigh in.</p>
					#endif
				</div>
			</div>
		</div>

		#if(volume.hasSamples):
			<div class="sample-viewer" id="sample-viewer" hidden>
				<button type="button" class="sample-viewer-close" id="sample-viewer-close" aria-label="Close">&times;</button>
				<img class="sample-viewer-img" id="sample-viewer-img" src="" alt="Sample page, enlarged">
			</div>

			<script>
			(function () {
			  // Click-to-enlarge sample viewer (task 11.1) - a plain overlay, not a full lightbox
			  // library: this page has no client-side framework, and a handful of thumbnails don't
			  // need more than click-to-open/click-to-close.
			  var thumbnails = document.getElementById('sample-thumbnails');
			  var viewer = document.getElementById('sample-viewer');
			  var viewerImg = document.getElementById('sample-viewer-img');
			  var closeBtn = document.getElementById('sample-viewer-close');
			  if (!thumbnails || !viewer) return;

			  thumbnails.querySelectorAll('.sample-thumbnail').forEach(function (thumb) {
			    thumb.addEventListener('click', function () {
			      viewerImg.src = thumb.src;
			      viewer.hidden = false;
			    });
			  });

			  function close() {
			    viewer.hidden = true;
			    viewerImg.src = '';
			  }
			  closeBtn.addEventListener('click', close);
			  viewer.addEventListener('click', function (e) {
			    if (e.target === viewer) close();
			  });
			})();
			</script>
		#endif
	#endexport
#endextend
