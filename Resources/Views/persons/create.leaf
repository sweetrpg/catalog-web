#extend("base"):
	#export("body"):
		<a class="back-link" href="#(meta.basePath)#(backPath)">&larr; #(meta.l10n.entity.persons)</a>

		<section class="page-header">
			<span class="section-label">#(meta.l10n.common.new)</span>
			<h2>#(meta.l10n.entity.person)</h2>
		</section>

		<form class="form" action="#(meta.basePath)#(submitPath)" method="post">
			#for(field in fields):
				<label class="form-label" for="#(field.key)">#(field.label)</label>
				<input class="input" type="text" id="#(field.key)" name="#(field.key)" value="#(field.value)">
			#endfor

			<div class="form-actions">
				<button type="submit" class="btn btn-primary">#(meta.l10n.common.create)</button>
				<a class="btn btn-ghost" href="#(meta.basePath)#(backPath)">#(meta.l10n.common.cancel)</a>
			</div>
		</form>
	#endexport
#endextend
