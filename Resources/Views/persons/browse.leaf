#extend("base"):
	#export("body"):
		<style>
		  /* Page-specific: the bulk-add result banner's failure list (catalog-entity-bulk-add) */
		  .bulk-add-result-list {
		    list-style: none;
		    padding: 0;
		    margin: 8px 0 0;
		    display: flex;
		    flex-direction: column;
		    gap: 4px;
		  }
		  .bulk-add-result-item {
		    display: flex;
		    justify-content: space-between;
		    gap: 8px;
		    font-size: 0.9rem;
		  }
		</style>

		<section class="page-header">
			<span class="section-label">#(meta.l10n.common.browse)</span>
			<h2>#(meta.l10n.entity.persons)</h2>
			<div class="page-header-toolbar">
				<form class="nav-search" action="#(meta.basePath)/persons" method="get">
					<input class="input" type="search" name="q" placeholder="#(meta.l10n.persons.search_placeholder)" value="#(query)">
					<select class="input" name="order" onchange="this.form.submit()">
						<option value="asc" #if(orderIsAsc): selected #endif>#(meta.l10n.persons.order_asc)</option>
						<option value="desc" #if(orderIsDesc): selected #endif>#(meta.l10n.persons.order_desc)</option>
					</select>
				</form>
				#if(canEdit):
					<a class="btn btn-primary" href="#(meta.basePath)/persons/new">#(meta.l10n.persons.add)</a>
				#endif
				#if(canBulkAdd):
					<a class="btn btn-ghost" href="#(meta.basePath)/persons/bulk-add">#(meta.l10n.persons.bulk_add)</a>
				#endif
			</div>
		</section>

		#if(hasBulkResult):
			#if(bulkFailedCount > 0):
				<div class="banner banner-warning" role="status">
					<p>#(meta.l10n.persons.added_prefix)#(bulkCreatedCount)#(meta.l10n.persons.added_suffix) #(bulkFailedCount)#(meta.l10n.persons.failed_suffix)</p>
					<ul class="bulk-add-result-list">
						#for(failure in bulkFailures):
							<li class="bulk-add-result-item">
								<span>#(failure.name)</span>
								<span>#(failure.error)</span>
							</li>
						#endfor
					</ul>
				</div>
			#else:
				<div class="banner banner-info" role="status">
					<p>#(meta.l10n.persons.added_prefix)#(bulkCreatedCount)#(meta.l10n.persons.added_suffix)</p>
				</div>
			#endif
		#endif

		#if(noResults):
			<p class="empty-state">#(meta.l10n.persons.no_results_prefix)#(query)#(meta.l10n.persons.no_results_suffix)</p>
		#endif

		<div class="card-grid">
			#for(item in items):
				<a class="card" href="#(meta.basePath)/persons/#(item.id)">
					<div class="card-body">
						<div class="card-title">#(item.name)</div>
					</div>
				</a>
			#endfor
		</div>

		#extend("partials/pagination")
	#endexport
#endextend
