<nav class="nav">
	<div class="nav-brand">
		<a href="#(meta.rootURL)">
			<img src="#(meta.sharedAssetsURL)/static/sweetrpg-logo-black.svg" alt="SweetRPG" class="nav-logo nav-logo-light">
			<img src="#(meta.sharedAssetsURL)/static/sweetrpg-logo-white.svg" alt="SweetRPG" class="nav-logo nav-logo-dark">
		</a>
		<a href="#(meta.basePath)/">Catalogue</a>
	</div>
	<a href="#(meta.basePath)/">Front Page</a>
	<a href="#(meta.basePath)/browse">Browse</a>
	<a href="#(meta.basePath)/shelves">My Shelves</a>
	<div class="nav-spacer"></div>
	<form class="nav-search" action="#(meta.basePath)/browse" method="get">
		<input class="input" type="text" name="q" placeholder="Search titles...">
	</form>
	<div class="avatar-menu">
		<button type="button" class="avatar-menu-trigger">
			#if(user):
				#if(user.avatarGravatarURL):
				<img class="avatar-menu-avatar" src="#(user.avatarGravatarURL)" alt="" loading="lazy" onload="this.nextElementSibling.style.display='none'" onerror="this.style.display='none'">
				#endif
				<span class="avatar-menu-fallback">#(user.avatarInitial)</span>
			#else:
				<img class="avatar-menu-avatar" src="#(meta.sharedAssetsURL)/static/mystery-man.svg" alt="">
			#endif
		</button>
		<div class="avatar-menu-panel" hidden>
			#if(user):
				<div class="avatar-menu-identity">
					<span class="avatar-menu-name">#(user.name)</span>
					#if(user.email):
					<span class="avatar-menu-email">#(user.email)</span>
					#endif
				</div>
				<hr class="avatar-menu-divider">
				<a class="avatar-menu-item" href="#(meta.userSettingsURL)">User Settings</a>
				#if(user.isAdmin):
				<a class="avatar-menu-item" href="#(meta.adminURL)">Administration</a>
				#endif
				<hr class="avatar-menu-divider">
				<form action="#(meta.logoutURL)" method="post" class="avatar-menu-item-form">
					<button type="submit" class="avatar-menu-item avatar-menu-item-danger">Log out</button>
				</form>
			#else:
				<a class="avatar-menu-item" href="#(meta.loginURL)">Log in</a>
			#endif
			<hr class="avatar-menu-divider">
			<div id="avatar-menu-theme-row" class="avatar-menu-theme-row" role="group" aria-label="Theme">
				<button type="button" class="avatar-menu-theme-option" data-theme-choice="light" aria-label="Light"></button>
				<button type="button" class="avatar-menu-theme-option" data-theme-choice="dark" aria-label="Dark"></button>
				<button type="button" class="avatar-menu-theme-option" data-theme-choice="system" aria-label="System"></button>
			</div>
		</div>
	</div>
</nav>
