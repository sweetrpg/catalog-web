			#else:
				<a class="pagination-page" href="#(link.url)">#(link.number)</a>
			#endif
		#endfor

		#if(pagination.hasNext):
			<a class="pagination-link" href="#(pagination.nextURL)" rel="next">#(meta.l10n.pagination.next) &rarr;</a>
		#else:
			<span class="pagination-link pagination-link-disabled">#(meta.l10n.pagination.next) &rarr;</span>
		#endif
